@model NID.Areas.ElectionTransport.Models.PublicRequestTrackViewModel
@{ ViewBag.Title="Track Transport Request"; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page"><div class="et-public-header"><h1>Track Election-Day Transport</h1><p>Enter the request number and only the last four digits of the mobile number used for the request.</p></div><div class="et-card" style="max-width:820px;margin:0 auto"><div class="et-card-body">@using(Html.BeginForm("Track","PublicTransport",new { area="ElectionTransport" },FormMethod.Post,null)){@Html.AntiForgeryToken()@Html.ValidationSummary(false)<div class="et-form-grid"><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.RequestNo)@Html.TextBoxFor(x=>x.RequestNo,new { @class="et-input",placeholder="TR-0000000001" })</div><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.MobileLast4)@Html.TextBoxFor(x=>x.MobileLast4,new { @class="et-input",maxlength="4",placeholder="4567" })</div></div><button type="submit" class="et-btn primary">Check status</button>} @if(Model.Status!=null){<div class="et-card" style="margin-top:18px"><div class="et-card-body"><div class="et-card-head"><div><h2>@Model.Status.RequestNo</h2><div class="et-sub">@Model.Status.PublicMessage</div></div><span class="et-badge blue">@Model.Status.RequestStatus</span></div><div class="et-stat-row"><div class="et-stat"><span>Polling station</span><strong>@(Model.Status.PollingStationName??"To be confirmed")</strong></div><div class="et-stat"><span>Vehicle</span><strong>@(Model.Status.VehicleRegistrationNo??"Not assigned")</strong></div><div class="et-stat"><span>Driver</span><strong>@(Model.Status.DriverName??"Not assigned")</strong></div><div class="et-stat"><span>Driver mobile</span><strong>@(Model.Status.DriverMobileMasked??"—")</strong></div></div></div></div>}</div></div></div>
@section scripts { <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script> }
