@model NID.Areas.ElectionTransport.Models.PublicTransportRequestViewModel
@{ ViewBag.Title="Request Election-Day Transport"; var context=ViewBag.Context as NID.Areas.ElectionTransport.Models.ElectionContextDto; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">
<div class="et-public-header"><h1>Election-Day Transport Assistance</h1><p>@(context==null?"Election transport service":context.DisplayText) · Home pickup support for elderly persons, persons with mobility needs and households requiring assistance to reach the assigned polling station.</p></div>
<div class="et-public-layout">
<article class="et-card"><div class="et-card-body"><div class="et-card-head"><div><h2>Mark the pickup location</h2><div class="et-sub">Use your current location or click the map. Drag the marker to correct the exact pickup point.</div></div><button id="et-use-location" type="button" class="et-btn primary">Use current location</button></div><div id="et-public-map" class="et-public-map"></div><div class="et-privacy-note" style="margin-top:11px">The location and contact details are used only to coordinate the requested transport. The form does not ask how anyone intends to vote.</div></div></article>
<article class="et-card"><div class="et-card-body">@using(Html.BeginForm("Request","PublicTransport",new { area="ElectionTransport" },FormMethod.Post,new { id="et-request-form",autocomplete="off" })) { @Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ElectionContextId) @Html.HiddenFor(x=>x.ServicePartyId) @Html.HiddenFor(x=>x.ServiceCandidateId) @Html.HiddenFor(x=>x.Latitude) @Html.HiddenFor(x=>x.Longitude)
@Html.ValidationSummary(false)
<div class="et-form-group"><label>Transport service pool</label><div class="et-input" style="background:#f8fbfa">@Model.ServicePoolName</div></div>
<div class="et-form-group">@Html.LabelFor(x=>x.PollingStationId)@Html.DropDownListFor(x=>x.PollingStationId,Model.PollingStations,"Select if known",new { @class="et-select" })</div>
<div class="et-form-grid"><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.RequestedByName)@Html.TextBoxFor(x=>x.RequestedByName,new { @class="et-input" })@Html.ValidationMessageFor(x=>x.RequestedByName,null,new { @class="et-validation" })</div><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.Mobile)@Html.TextBoxFor(x=>x.Mobile,new { @class="et-input" })@Html.ValidationMessageFor(x=>x.Mobile,null,new { @class="et-validation" })</div></div>
<div class="et-form-group">@Html.LabelFor(x=>x.PickupAddress)@Html.TextAreaFor(x=>x.PickupAddress,new { @class="et-textarea",rows=2 })@Html.ValidationMessageFor(x=>x.PickupAddress,null,new { @class="et-validation" })</div>
<div class="et-form-grid"><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.PickupArea)@Html.TextBoxFor(x=>x.PickupArea,new { @class="et-input" })</div><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.PassengerCount)@Html.TextBoxFor(x=>x.PassengerCount,new { @class="et-input",type="number",min="1",max="20" })</div></div>
<div class="et-form-grid"><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.AccessibilityCategory)@Html.DropDownListFor(x=>x.AccessibilityCategory,new[]{new SelectListItem{Value="General",Text="General assistance"},new SelectListItem{Value="Elderly",Text="Elderly person"},new SelectListItem{Value="Mobility Assistance",Text="Mobility assistance"},new SelectListItem{Value="Medical",Text="Medical assistance"}},"Select category",new { @class="et-select" })</div><div class="et-form-group et-col-6">@Html.LabelFor(x=>x.RequestedPickupLocal)@Html.TextBoxFor(x=>x.RequestedPickupLocal,"{0:yyyy-MM-ddTHH:mm}",new { @class="et-input",type="datetime-local" })</div></div>
<div class="et-form-group"><label class="et-checkbox">@Html.CheckBoxFor(x=>x.RequiresWheelchair) @Html.DisplayNameFor(x=>x.RequiresWheelchair)</label></div><div class="et-form-group"><label class="et-checkbox">@Html.CheckBoxFor(x=>x.RequiresAttendant) @Html.DisplayNameFor(x=>x.RequiresAttendant)</label></div><div class="et-form-group"><label class="et-checkbox">@Html.CheckBoxFor(x=>x.IsRoundTripRequired) @Html.DisplayNameFor(x=>x.IsRoundTripRequired)</label></div>
<div class="et-form-group">@Html.LabelFor(x=>x.Notes)@Html.TextAreaFor(x=>x.Notes,new { @class="et-textarea",rows=2,placeholder="Landmark, call-before-arrival or accessibility instructions" })</div>
<div class="et-privacy-note"><label class="et-checkbox">@Html.CheckBoxFor(x=>x.PrivacyConsent) @Html.DisplayNameFor(x=>x.PrivacyConsent)</label>@Html.ValidationMessageFor(x=>x.PrivacyConsent,null,new { @class="et-validation" })</div>
<div style="display:flex;gap:9px;margin-top:14px"><button type="submit" class="et-btn primary" style="flex:1">Submit transport request</button><a class="et-btn light" href="@Url.Action("Track","PublicTransport",new { area="ElectionTransport" })">Track request</a></div>
}</div></article>
</div></div>
@section scripts { <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.public-request.js")"></script><script>ElectionTransport.PublicRequest.init({defaultLatitude:30.4,defaultLongitude:69.3});</script> }
