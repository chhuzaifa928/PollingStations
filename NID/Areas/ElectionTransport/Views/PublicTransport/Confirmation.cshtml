@model NID.Areas.ElectionTransport.Models.PublicRequestConfirmationViewModel
@{ ViewBag.Title="Transport Request Received"; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page"><div class="et-public-header"><h1>Transport Request Received</h1><p>Keep the request number safely. It is required with the last four mobile digits for tracking.</p></div><div class="et-card" style="max-width:760px;margin:0 auto"><div class="et-card-body" style="text-align:center;padding:32px"><div class="et-list-icon" style="margin:0 auto;width:62px;height:62px;font-size:28px">✓</div><div class="et-kicker" style="color:#667085;margin-top:15px">Request number</div><div style="font-size:34px;font-weight:900;color:#0f725c;margin-top:5px">@Model.RequestNo</div><div style="margin-top:10px">@Model.Message</div><div class="et-stat-row" style="margin-top:20px"><div class="et-stat"><span>Status</span><strong>@Model.RequestStatus</strong></div><div class="et-stat"><span>Polling station</span><strong>@(Model.PollingStationName??"To be confirmed")</strong></div></div><div style="display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-top:22px"><a class="et-btn primary" href="@Url.Action("Track","PublicTransport",new { area="ElectionTransport" })">Track request</a><a class="et-btn light" href="@Url.Action("Request","PublicTransport",new { area="ElectionTransport" })">Submit another request</a></div></div></div></div>
@section scripts { <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script> }
