@model NID.Areas.ElectionTransport.Models.TransportPageViewModel
@{ ViewBag.Title="Election Transport Analytics"; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml",Model)
<div class="et-grid"><article class="et-card et-span-7"><div class="et-card-body"><div class="et-card-head"><div><h2>Vehicle productivity matrix</h2><div class="et-sub">Distance versus valid trips separates star vehicles, underutilized vehicles and suspiciously inactive vehicles.</div></div></div><div class="et-chart tall"><canvas id="et-productivity-chart"></canvas></div></div></article><article class="et-card et-span-5"><div class="et-card-body"><div class="et-card-head"><div><h2>Provider effectiveness score</h2><div class="et-sub">Operational fulfilment, activation and trip delivery.</div></div></div><div class="et-chart tall"><canvas id="et-provider-chart"></canvas></div></div></article><article class="et-card et-span-7"><div class="et-card-body"><div class="et-card-head"><div><h2>Station transport intensity</h2><div class="et-sub">Trips and online vehicles for the highest-voter polling stations.</div></div></div><div class="et-chart"><canvas id="et-station-chart"></canvas></div></div></article><article class="et-card et-span-5"><div class="et-card-body"><div class="et-card-head"><div><h2>Decision insights</h2><div class="et-sub">Automatically identifies strongest delivery, weak providers and high-voter service gaps.</div></div></div><div id="et-analytics-insights" class="et-side-list"><div class="et-empty">Loading insights…</div></div></div></article></div></div>
@section scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.analytics.js")"></script><script>ElectionTransport.Analytics.init({contextId:@Model.ElectionContextId,dashboardUrl:'@Url.Action("Dashboard","TransportApi",new { area="ElectionTransport" })'});</script> }
