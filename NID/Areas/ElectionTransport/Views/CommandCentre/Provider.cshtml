@model NID.Areas.ElectionTransport.Models.TransportDetailPageViewModel<NID.Areas.ElectionTransport.Models.ProviderDetailsDto>
@{ ViewBag.Title="Provider Details"; var p=Model.Data.Provider; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml",Model)
<div class="et-shell et-toolbar"><div class="et-field"><div class="et-name" style="font-size:18px">@p.ProviderName</div><div class="et-sub">@p.ProviderType · @p.Mobile · @(p.CandidateName??p.PartyName??"No candidate/party link")</div></div><a class="et-btn green-light" href="@Url.Action("ManageProvider","CommandCentre",new { area="ElectionTransport",contextId=Model.ElectionContextId,id=p.ProviderId })">Edit provider</a><a class="et-btn light" href="@Url.Action("Providers","CommandCentre",new { area="ElectionTransport",contextId=Model.ElectionContextId })">Back</a></div>
<div class="et-grid"><article class="et-card et-kpi"><div class="et-kpi-label">Promised</div><div class="et-kpi-value">@p.PromisedVehicles</div><div class="et-kpi-foot">Commitment recorded</div></article><article class="et-card et-kpi blue"><div class="et-kpi-label">Registered</div><div class="et-kpi-value">@p.RegisteredVehicles</div><div class="et-kpi-foot">Vehicles linked to provider</div></article><article class="et-card et-kpi purple"><div class="et-kpi-label">Operational</div><div class="et-kpi-value">@p.OperationalVehicles</div><div class="et-kpi-foot">Recent valid GPS feed</div></article><article class="et-card et-kpi cyan"><div class="et-kpi-label">Trips</div><div class="et-kpi-value">@p.Trips</div><div class="et-kpi-foot">@p.DistanceKm.ToString("N1") km</div></article><article class="et-card et-kpi amber"><div class="et-kpi-label">Fulfilment</div><div class="et-kpi-value">@p.PromiseFulfilmentPercent.ToString("N1")%</div><div class="et-kpi-foot">Operational / promised</div></article><article class="et-card et-kpi red"><div class="et-kpi-label">Effectiveness</div><div class="et-kpi-value">@p.EffectivenessScore.ToString("N1")</div><div class="et-kpi-foot">@p.PerformanceClass</div></article>
<article class="et-card et-span-8"><div class="et-card-body"><div class="et-card-head"><div><h2>Provider vehicle fleet</h2></div></div><div class="et-table-wrap"><table class="et-table"><thead><tr><th>Vehicle</th><th>Driver</th><th>Polling station</th><th>Status</th><th class="right">Trips</th><th class="right">Distance</th><th></th></tr></thead><tbody>@foreach(var v in Model.Data.Vehicles){<tr><td>@v.RegistrationNo · @v.VehicleType</td><td>@v.DriverName</td><td>@v.PollingStationName</td><td>@v.EffectiveStatus</td><td class="right">@v.TodayTrips</td><td class="right">@v.TodayDistanceKm.ToString("N1")</td><td><a class="et-btn small light" href="@Url.Action("Vehicle","CommandCentre",new { area="ElectionTransport",id=v.VehicleAssignmentId })">Open</a></td></tr>}@if(!Model.Data.Vehicles.Any()){<tr><td colspan="7" class="et-empty">No vehicles registered.</td></tr>}</tbody></table></div></div></article>
<article class="et-card et-span-4"><div class="et-card-body"><div class="et-card-head"><div><h2>Commitment history</h2></div></div><div class="et-side-list">@foreach(var c in Model.Data.Commitments){<div class="et-list-item"><div class="et-list-icon">🤝</div><div><div class="et-list-title">@c.PromisedQuantity vehicles · @c.CommitmentStatus</div><div class="et-list-meta">@(c.PollingStationName??"Constituency-wide") · @(c.VehicleType??"Mixed types") · @(c.CommitmentDate.HasValue?c.CommitmentDate.Value.ToString("dd-MMM-yyyy"):"—")</div></div></div>}@if(!Model.Data.Commitments.Any()){<div class="et-empty">No commitments recorded.</div>}</div></div></article></div></div>
@section scripts { <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script> }
