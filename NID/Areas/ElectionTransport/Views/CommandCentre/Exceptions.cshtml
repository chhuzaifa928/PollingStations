@model NID.Areas.ElectionTransport.Models.TransportPageViewModel
@{
    ViewBag.Title = "Election Transport Exceptions";
}

@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")

<style>
    .et-ex-page {
        padding-bottom: 28px;
    }

    .et-ex-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 14px;
        padding: 18px 20px;
        color: #fff;
        background: linear-gradient(118deg,#102b49 0%,#173e5f 62%,#7b2f2f 100%);
        border-radius: 15px;
    }

        .et-ex-hero h1 {
            margin: 0;
            color: #fff;
            font-size: 23px;
            font-weight: 900;
        }

        .et-ex-hero p {
            max-width: 820px;
            margin: 6px 0 0;
            color: rgba(255,255,255,.79);
            font-size: 11.5px;
            line-height: 1.5;
        }

    .et-ex-hero-count {
        min-width: 155px;
        padding: 11px 14px;
        text-align: right;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 11px;
    }

        .et-ex-hero-count span {
            display: block;
            color: rgba(255,255,255,.68);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .et-ex-hero-count strong {
            display: block;
            margin-top: 3px;
            color: #fff;
            font-size: 18px;
            font-weight: 900;
        }

    .et-ex-feed-state {
        margin-top: 3px;
        color: rgba(255,255,255,.65);
        font-size: 9px;
    }

    .et-ex-kpis {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .et-ex-kpi {
        position: relative;
        overflow: hidden;
        min-height: 103px;
        padding: 13px 14px;
        background: #fff;
        border: 1px solid #dfe8e5;
        border-radius: 12px;
    }

        .et-ex-kpi:before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: #526b61;
        }

        .et-ex-kpi.critical:before {
            background: #d92d20;
        }

        .et-ex-kpi.offline:before {
            background: #b54708;
        }

        .et-ex-kpi.blue:before {
            background: #2e6fd0;
        }

        .et-ex-kpi.green:before {
            background: #0f8a64;
        }

    .et-ex-kpi-label {
        color: #7b8883;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .3px;
        text-transform: uppercase;
    }

    .et-ex-kpi-value {
        margin-top: 5px;
        color: #1f374c;
        font-size: 24px;
        font-weight: 900;
        line-height: 1;
    }

    .et-ex-kpi-foot {
        margin-top: 7px;
        color: #7b8883;
        font-size: 9.5px;
        line-height: 1.35;
    }

    .et-ex-brief {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 14px;
        padding: 13px 15px;
        background: #fff8f5;
        border: 1px solid #f2d5ce;
        border-left: 4px solid #d92d20;
        border-radius: 11px;
    }

    .et-ex-brief-mark {
        display: flex;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        align-items: center;
        justify-content: center;
        color: #b42318;
        background: #fee4e2;
        border-radius: 9px;
        font-size: 16px;
        font-weight: 900;
    }

    .et-ex-brief strong {
        display: block;
        color: #3e332f;
        font-size: 12.5px;
    }

    .et-ex-brief span {
        display: block;
        margin-top: 4px;
        color: #715f58;
        font-size: 10.5px;
        line-height: 1.45;
    }

    .et-ex-analysis-grid {
        display: grid;
        grid-template-columns: 1fr 1.15fr 1.35fr;
        gap: 12px;
        margin-bottom: 14px;
    }

    .et-ex-analysis-card {
        min-height: 280px;
        background: #fff;
        border: 1px solid #dfe8e5;
        border-radius: 13px;
    }

        .et-ex-analysis-card h2 {
            font-size: 15px;
        }

    .et-ex-severity-layout {
        display: grid;
        grid-template-columns: 130px 1fr;
        gap: 14px;
        align-items: center;
        margin-top: 14px;
    }

    .et-ex-donut {
        position: relative;
        width: 122px;
        height: 122px;
        margin: auto;
        border-radius: 50%;
        background: #e4e7ec;
    }

        .et-ex-donut:after {
            content: "";
            position: absolute;
            inset: 23px;
            background: #fff;
            border-radius: 50%;
        }

    .et-ex-donut-center {
        position: absolute;
        z-index: 2;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #667085;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

        .et-ex-donut-center strong {
            color: #1f374c;
            font-size: 23px;
            line-height: 1;
        }

    .et-ex-viz-legend-row {
        display: grid;
        grid-template-columns: 10px 1fr auto;
        gap: 6px;
        align-items: center;
        padding: 4px 0;
        color: #61716b;
        font-size: 10px;
    }

        .et-ex-viz-legend-row .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .et-ex-viz-legend-row strong {
            color: #263d51;
            font-size: 11px;
        }

    .et-ex-viz-bars {
        margin-top: 10px;
    }

    .et-ex-viz-bar-row {
        margin-bottom: 11px;
    }

        .et-ex-viz-bar-row:last-child {
            margin-bottom: 0;
        }

    .et-ex-viz-bar-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 4px;
        color: #52645f;
        font-size: 10px;
    }

        .et-ex-viz-bar-head span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .et-ex-viz-bar-head strong {
            color: #20384d;
            font-size: 11px;
        }

    .et-ex-viz-track {
        height: 8px;
        overflow: hidden;
        background: #edf1f0;
        border-radius: 8px;
    }

        .et-ex-viz-track span {
            display: block;
            height: 100%;
            background: #426b7a;
            border-radius: inherit;
        }

    .et-ex-toolbar {
        display: grid;
        grid-template-columns: minmax(230px,1.5fr) repeat(3,minmax(150px,.7fr)) auto auto;
        gap: 10px;
        align-items: end;
        margin-bottom: 14px;
        padding: 13px;
        background: #fff;
        border: 1px solid #dfe8e5;
        border-radius: 12px;
    }

        .et-ex-toolbar .et-field {
            min-width: 0;
        }

    .et-ex-table-card {
        overflow: hidden;
        border-top: 3px solid #7a2e2e;
    }

        .et-ex-table-card .et-card-head h2 {
            font-size: 17px;
        }

    .et-ex-result-count {
        color: #6f7d78;
        font-size: 10px;
        white-space: nowrap;
    }

        .et-ex-result-count strong {
            color: #243d52;
            font-size: 12px;
        }

    .et-ex-table-wrap {
        margin-top: 12px;
        border: 1px solid #e1e8e6;
        border-radius: 10px;
    }

    .et-ex-table {
        font-size: 11.5px;
    }

        .et-ex-table thead th {
            padding: 11px 9px;
            color: #52645f;
            background: #f3f7f5;
            font-size: 9px;
            letter-spacing: .25px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .et-ex-table tbody td {
            padding: 11px 9px;
            vertical-align: middle;
        }

    .et-ex-row td:first-child {
        position: relative;
        padding-left: 13px;
    }

        .et-ex-row td:first-child:before {
            content: "";
            position: absolute;
            top: 7px;
            bottom: 7px;
            left: 0;
            width: 3px;
            border-radius: 4px;
            background: #98a2b3;
        }

    .et-ex-row.et-ex-critical td:first-child:before, .et-ex-row.et-ex-high td:first-child:before {
        background: #d92d20;
    }

    .et-ex-row.et-ex-medium td:first-child:before {
        background: #dc6803;
    }

    .et-ex-row.et-ex-low td:first-child:before {
        background: #2e6fd0;
    }

    .et-ex-severity-block strong {
        display: block;
        font-size: 11px;
        font-weight: 900;
    }

    .et-ex-severity-block span {
        display: block;
        margin-top: 3px;
        color: #7b8883;
        font-size: 9px;
        white-space: nowrap;
    }

    .et-ex-severity-block.critical strong, .et-ex-severity-block.high strong {
        color: #b42318;
    }

    .et-ex-severity-block.medium strong {
        color: #b54708;
    }

    .et-ex-severity-block.low strong {
        color: #1849a9;
    }

    .et-ex-vehicle strong {
        display: block;
        color: #20384d;
        font-size: 12.5px;
        font-weight: 900;
    }

    .et-ex-vehicle span, .et-ex-reason span {
        display: block;
        margin-top: 3px;
        color: #76837f;
        font-size: 9.5px;
        line-height: 1.35;
    }

    .et-ex-main-text, .et-ex-station {
        color: #334b5f;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.35;
    }

    .et-ex-reason {
        max-width: 300px;
    }

        .et-ex-reason strong {
            display: block;
            color: #3c4c47;
            font-size: 10.5px;
        }

    .et-ex-age {
        display: inline-flex;
        justify-content: center;
        min-width: 65px;
        padding: 5px 7px;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 900;
        white-space: nowrap;
    }

        .et-ex-age.recent {
            color: #067647;
            background: #ecfdf3;
        }

        .et-ex-age.watch {
            color: #b54708;
            background: #fff4e5;
        }

        .et-ex-age.urgent {
            color: #b42318;
            background: #fff1f0;
        }

        .et-ex-age.neutral {
            color: #475467;
            background: #f2f4f7;
        }

    .et-ex-trip-count {
        display: inline-flex;
        min-width: 28px;
        justify-content: center;
        padding: 4px 6px;
        color: #1849a9;
        background: #eff4ff;
        border-radius: 6px;
        font-weight: 900;
    }

        .et-ex-trip-count.zero {
            color: #b42318;
            background: #fff1f0;
        }

    @@media (max-width:1180px) {
        .et-ex-kpis {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .et-ex-analysis-grid {
            grid-template-columns: 1fr;
        }

        .et-ex-toolbar {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width:700px) {
        .et-ex-hero {
            align-items: stretch;
            flex-direction: column;
        }

        .et-ex-hero-count {
            text-align: left;
        }

        .et-ex-kpis, .et-ex-toolbar {
            grid-template-columns: 1fr;
        }

        .et-ex-severity-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="et-page et-ex-page">
    @Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml", Model)

    <section class="et-shell et-ex-hero">
        <div>
            <h1>Election Transport Exception Centre</h1>
            <p>Live intervention view of offline, never-activated, idle and no-trip vehicles. Every statistic and visualization below is calculated from the same exception records shown in the intervention table.</p>
        </div>
        <div class="et-ex-hero-count">
            <span>Current exposure</span>
            <strong id="et-exception-count">0 exceptions</strong>
            <div id="et-ex-data-state" class="et-ex-feed-state">Connecting to live feed...</div>
        </div>
    </section>

    <section class="et-shell et-ex-kpis">
        <article class="et-ex-kpi critical"><div class="et-ex-kpi-label">Total exceptions</div><div id="et-ex-kpi-total" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot"><span id="et-ex-critical-rate">0% high-priority</span></div></article>
        <article class="et-ex-kpi critical"><div class="et-ex-kpi-label">Critical / high</div><div id="et-ex-kpi-critical" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot">Vehicles requiring immediate command-centre attention</div></article>
        <article class="et-ex-kpi offline"><div class="et-ex-kpi-label">Offline / GPS gap</div><div id="et-ex-kpi-offline" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot">Vehicles with communication or location-feed gaps</div></article>
        <article class="et-ex-kpi offline"><div class="et-ex-kpi-label">Never activated</div><div id="et-ex-kpi-never" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot">Vehicles that never established a live location session</div></article>
        <article class="et-ex-kpi blue"><div class="et-ex-kpi-label">No valid trips</div><div id="et-ex-kpi-notrips" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot">Visible vehicles with no recorded transport trip today</div></article>
        <article class="et-ex-kpi green"><div class="et-ex-kpi-label">Providers affected</div><div id="et-ex-kpi-providers" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot">Distinct providers represented in current exceptions</div></article>
        <article class="et-ex-kpi blue"><div class="et-ex-kpi-label">Stations affected</div><div id="et-ex-kpi-stations" class="et-ex-kpi-value">0</div><div class="et-ex-kpi-foot">Polling stations linked to exception vehicles</div></article>
        <article class="et-ex-kpi"><div class="et-ex-kpi-label">Average GPS silence</div><div id="et-ex-kpi-silence" class="et-ex-kpi-value">0 min</div><div class="et-ex-kpi-foot">Average minutes since last report where available</div></article>
    </section>

    <section class="et-shell et-ex-brief"><div class="et-ex-brief-mark">!</div><div><strong id="et-ex-brief-title">Assessing command-centre exposure</strong><span id="et-ex-brief-copy">Loading current exception priorities...</span></div></section>

    <section class="et-shell et-ex-analysis-grid">
        <article class="et-ex-analysis-card"><div class="et-card-body"><div class="et-card-head"><div><h2>Severity mix</h2><div class="et-sub">Share of current exception load by intervention priority.</div></div></div><div class="et-ex-severity-layout"><div class="et-ex-donut" id="et-ex-severity-donut"><div class="et-ex-donut-center"><strong id="et-ex-severity-total">0</strong><span>Total</span></div></div><div id="et-ex-severity-legend"></div></div></div></article>
        <article class="et-ex-analysis-card"><div class="et-card-body"><div class="et-card-head"><div><h2>Exception causes</h2><div class="et-sub">Operational reasons driving command-centre intervention.</div></div></div><div id="et-ex-cause-bars" class="et-ex-viz-bars"><div class="et-empty">Loading...</div></div></div></article>
        <article class="et-ex-analysis-card"><div class="et-card-body"><div class="et-card-head"><div><h2>Provider exposure</h2><div class="et-sub">Providers carrying the highest current exception burden.</div></div></div><div id="et-ex-provider-bars" class="et-ex-viz-bars"><div class="et-empty">Loading...</div></div></div></article>
    </section>

    <section class="et-shell et-ex-toolbar">
        <div class="et-field"><label for="et-exception-search">Search exceptions</label><input id="et-exception-search" class="et-input" type="text" placeholder="Vehicle, driver, provider, station, status or reason" /></div>
        <div class="et-field"><label for="et-exception-severity">Severity</label><select id="et-exception-severity" class="et-select"><option value="">All severities</option></select></div>
        <div class="et-field"><label for="et-exception-type">Exception type</label><select id="et-exception-type" class="et-select"><option value="">All exception types</option></select></div>
        <div class="et-field"><label for="et-exception-sort">Sort by</label><select id="et-exception-sort" class="et-select"><option value="priority">Priority first</option><option value="lastseen">Longest GPS silence</option><option value="trips">Fewest trips</option><option value="provider">Provider name</option><option value="station">Polling station</option></select></div>
        <button id="et-exception-clear" class="et-btn light" type="button">Clear</button>
        <button id="et-refresh-exceptions" class="et-btn navy" type="button">Refresh</button>
    </section>

    <section class="et-shell et-card et-ex-table-card"><div class="et-card-body"><div class="et-card-head"><div><h2>Priority intervention queue</h2><div class="et-sub">Use one live dataset to identify, prioritize and review vehicles requiring recovery action.</div></div><div class="et-ex-result-count">Showing <strong id="et-exception-visible-count">0</strong> of <strong id="et-exception-total-count">0</strong></div></div><div class="et-table-wrap et-ex-table-wrap"><table class="et-table et-ex-table"><thead><tr><th>Priority</th><th>Vehicle / driver</th><th>Provider</th><th>Polling station</th><th>Status</th><th class="right">GPS silence</th><th class="right">Trips</th><th>Operational reason</th><th></th></tr></thead><tbody id="et-exceptions-body"><tr><td colspan="9" class="et-empty">Loading exceptions...</td></tr></tbody></table></div></div></section>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script>
    <script src="@Url.Content("~/Scripts/ElectionTransport/transport.exceptions.js?v=2")"></script>
    <script>
        ElectionTransport.Exceptions.init({
            contextId: @Model.ElectionContextId,
            url: '@Url.Action("Exceptions", "TransportApi", new { area = "ElectionTransport" })',
            vehicleDetailsUrl: '@Url.Action("Vehicle", "CommandCentre", new { area = "ElectionTransport", id = "__id__" })'
        });
    </script>
}
