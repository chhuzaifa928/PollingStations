@model NID.Areas.ElectionTransport.Models.TransportDetailPageViewModel<NID.Areas.ElectionTransport.Models.PollingStationDetailsDto>
@{ ViewBag.Title = "Polling Station Transport Details"; var s = Model.Data.PollingStation; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">
    @Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml", Model)
    <div class="et-shell et-toolbar"><div class="et-field"><div class="et-name" style="font-size:18px">Polling Station Sr @s.Sr</div><div class="et-sub">@s.PollingStationName · @s.District · @s.TotalVoters voters</div></div><a class="et-btn light" href="@Url.Action("PollingStations","CommandCentre",new { area="ElectionTransport",contextId=Model.ElectionContextId })">Back to stations</a></div>
    <div class="et-grid">
        <article class="et-card et-kpi"><div class="et-kpi-label">Assigned vehicles</div><div class="et-kpi-value">@s.AssignedVehicles</div><div class="et-kpi-foot">@s.PromisedVehicles promised</div></article>
        <article class="et-card et-kpi blue"><div class="et-kpi-label">Online vehicles</div><div class="et-kpi-value">@s.OnlineVehicles</div><div class="et-kpi-foot">@s.ApproachingVehicles approaching · @s.AtPollingStationVehicles at station</div></article>
        <article class="et-card et-kpi purple"><div class="et-kpi-label">Valid trips</div><div class="et-kpi-value">@s.ValidTrips</div><div class="et-kpi-foot">@s.DistanceKm.ToString("N1") km travelled</div></article>
        <article class="et-card et-kpi cyan"><div class="et-kpi-label">Confirmed passengers</div><div class="et-kpi-value">@s.ConfirmedPassengers</div><div class="et-kpi-foot">Passengers on validated trips</div></article>
        <article class="et-card et-kpi amber"><div class="et-kpi-label">Open requests</div><div class="et-kpi-value">@s.OpenTransportRequests</div><div class="et-kpi-foot">@s.CompletedTransportRequests completed</div></article>
        <article class="et-card et-kpi red"><div class="et-kpi-label">Service status</div><div class="et-kpi-value" style="font-size:18px">@s.ServiceStatus</div><div class="et-kpi-foot">@s.OfflineVehicles offline · @s.NeverActivatedVehicles never activated</div></article>
        <article class="et-card et-span-8"><div class="et-card-body"><div class="et-card-head"><div><h2>Polling-station vehicle map</h2><div class="et-sub">Assigned live vehicles and @Model.SelectedContext.GeofenceRadiusMeters-metre station buffer.</div></div></div><div id="et-station-detail-map" class="et-map"></div></div></article>
        <article class="et-card et-span-4"><div class="et-card-body"><div class="et-card-head"><div><h2>Assigned vehicles</h2></div></div><div class="et-side-list">@foreach (var v in Model.Data.Vehicles) { <div class="et-list-item"><div class="et-list-icon">@(v.IconKey == "rickshaw" ? "🛺" : v.IconKey == "jeep" ? "🚙" : v.IconKey == "van" ? "🚐" : v.IconKey == "coaster" || v.IconKey == "bus" ? "🚌" : "🚗")</div><div><div class="et-list-title">@v.RegistrationNo · @v.DriverName</div><div class="et-list-meta">@v.TodayTrips trips · @v.TodayDistanceKm.ToString("N1") km</div></div><a class="et-btn small light" href="@Url.Action("Vehicle","CommandCentre",new { area="ElectionTransport",id=v.VehicleAssignmentId })">Open</a></div> } @if (!Model.Data.Vehicles.Any()) { <div class="et-empty">No vehicles assigned.</div> }</div></div></article>
        <article class="et-card et-span-7"><div class="et-card-body"><div class="et-card-head"><div><h2>Recent trip arrivals</h2></div></div><div class="et-table-wrap"><table class="et-table"><thead><tr><th>Vehicle</th><th>Driver</th><th>Arrival</th><th class="right">Distance</th><th class="right">Passengers</th><th>Status</th></tr></thead><tbody>@foreach (var t in Model.Data.RecentTrips) { <tr><td>@t.RegistrationNo</td><td>@t.DriverName</td><td>@(t.ArrivedAtUtc.HasValue?t.ArrivedAtUtc.Value.ToString("dd-MMM HH:mm"):"—")</td><td class="right">@(t.DistanceKm.HasValue?t.DistanceKm.Value.ToString("N2"):"—")</td><td class="right">@(t.ConfirmedPassengers.HasValue?t.ConfirmedPassengers.Value.ToString():"—")</td><td>@t.ValidationStatus</td></tr> } @if (!Model.Data.RecentTrips.Any()) { <tr><td colspan="6" class="et-empty">No trips recorded.</td></tr> }</tbody></table></div></div></article>
        <article class="et-card et-span-5"><div class="et-card-body"><div class="et-card-head"><div><h2>Home transport demand</h2></div></div><div class="et-side-list">@foreach (var r in Model.Data.Requests) { <div class="et-list-item"><div class="et-list-icon">🏠</div><div><div class="et-list-title">@r.RequestNo · @r.RequestedByName</div><div class="et-list-meta">@r.PickupArea · @r.PassengerCount passengers · @r.RequestStatus</div></div></div> } @if (!Model.Data.Requests.Any()) { <div class="et-empty">No requests for this station.</div> }</div></div></article>
    </div>
</div>
@section scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.details.js")"></script>
<script>
ElectionTransport.Details.station({ latitude:@(s.Latitude.HasValue?s.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture):"0"), longitude:@(s.Longitude.HasValue?s.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture):"0"), sr:@s.Sr, geofenceRadius:@Model.SelectedContext.GeofenceRadiusMeters, vehicles:@Html.Raw(Json.Encode(Model.Data.Vehicles)), vehicleDetailsUrl:'@Url.Action("Vehicle","CommandCentre",new { area="ElectionTransport",id="__id__" })' });
</script>
}
