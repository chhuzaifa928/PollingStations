@model NID.Areas.ElectionTransport.Models.TransportPageViewModel
@{ ViewBag.Title = "Provider Accountability"; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml",Model)
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportMessages.cshtml")
<div class="et-shell et-toolbar"><div class="et-field"><label>Provider / influencer accountability</label><div class="et-sub">Promised versus registered versus activated versus genuinely operational vehicles.</div></div><button id="et-refresh-providers" type="button" class="et-btn navy">Refresh</button><a class="et-btn primary" href="@Url.Action("ManageProvider","CommandCentre",new { area="ElectionTransport",contextId=Model.ElectionContextId })">Add provider</a><span id="et-provider-count" class="et-badge blue">0 providers</span></div>
<div class="et-shell et-card"><div class="et-card-body"><div class="et-card-head"><div><h2>Provider effectiveness and promise fulfilment</h2><div class="et-sub">The effectiveness score combines operational fulfilment, activation and trip delivery.</div></div></div><div class="et-table-wrap"><table class="et-table"><thead><tr><th>Provider</th><th>Candidate / party</th><th class="right">Promised</th><th class="right">Registered</th><th class="right">Operational</th><th class="right">Trips</th><th class="right">Distance</th><th class="right">Fulfilment</th><th>Class</th><th>Actions</th></tr></thead><tbody id="et-providers-body"><tr><td colspan="10" class="et-empty">Loading providers…</td></tr></tbody></table></div></div></div>
</div>
@section scripts { <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.lists.js")"></script><script>ElectionTransport.Lists.providers({contextId:@Model.ElectionContextId,url:'@Url.Action("Providers","TransportApi",new { area="ElectionTransport" })',detailsUrl:'@Url.Action("Provider","CommandCentre",new { area="ElectionTransport",id="__id__" })',editUrl:'@Url.Action("ManageProvider","CommandCentre",new { area="ElectionTransport",contextId="__context__",id="__id__" })'});</script> }
