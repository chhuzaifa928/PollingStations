@model NID.Areas.ElectionTransport.Models.TransportPageViewModel
@{ ViewBag.Title="Validated Polling-Station Trips"; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml",Model)
<div class="et-shell et-toolbar"><div class="et-field"><label>Trip validation</label><div class="et-sub">A trip requires meaningful travel, entry into the @Model.SelectedContext.GeofenceRadiusMeters-metre polling-station buffer and minimum dwell time.</div></div><button id="et-refresh-trips" class="et-btn navy" type="button">Refresh</button></div>
<div class="et-grid"><article class="et-card et-span-12"><div class="et-card-body"><div class="et-card-head"><div><h2>Trips by time</h2><div class="et-sub">Validated polling-station arrivals across the current election context.</div></div></div><div class="et-chart"><canvas id="et-trip-chart"></canvas></div></div></article><article class="et-card et-span-12"><div class="et-card-body"><div class="et-card-head"><div><h2>Trip audit table</h2></div></div><div class="et-table-wrap"><table class="et-table"><thead><tr><th>Trip</th><th>Vehicle</th><th>Polling station</th><th>Provider</th><th>Arrival</th><th class="right">Distance km</th><th class="right">Duration min</th><th class="right">Dwell</th><th class="right">Passengers</th><th>Validation</th></tr></thead><tbody id="et-trips-body"><tr><td colspan="10" class="et-empty">Loading trips…</td></tr></tbody></table></div></div></article></div></div>
@section scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script><script src="@Url.Content("~/Scripts/ElectionTransport/transport.lists.js")"></script><script>ElectionTransport.Lists.trips({contextId:@Model.ElectionContextId,url:'@Url.Action("Trips","TransportApi",new { area="ElectionTransport" })'});</script> }
