@model NID.Areas.ElectionTransport.Models.TransportPageViewModel

@{
    ViewBag.Title = "Home and Accessibility Transport Requests";
}

@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")

<style>
    /* ========================================================================
       REQUESTS PAGE - compact professional dispatch workspace
       This CSS is deliberately page-scoped so no third file is required.
       ======================================================================== */

    .et-requests-v2 {
        padding-bottom: 34px;
    }

    .et-rq-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        margin-bottom: 15px;
        padding: 20px 22px;
        color: #fff;
        border-radius: 17px;
        background: radial-gradient(circle at 88% 18%, rgba(255,255,255,.13), transparent 28%), linear-gradient(120deg, #0c2647 0%, #174e76 54%, #0f725c 100%);
        box-shadow: 0 12px 30px rgba(12,38,71,.13);
    }

    .et-rq-hero-main {
        min-width: 0;
    }

    .et-rq-eyebrow {
        margin-bottom: 4px;
        color: rgba(255,255,255,.68);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .et-rq-hero h1 {
        margin: 0;
        color: #fff;
        font-size: 26px;
        font-weight: 850;
        letter-spacing: -.35px;
    }

    .et-rq-hero p {
        max-width: 900px;
        margin: 7px 0 0;
        color: rgba(255,255,255,.82);
        font-size: 12px;
        line-height: 1.55;
    }

    .et-rq-hero-count {
        min-width: 170px;
        padding: 11px 14px;
        text-align: right;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 12px;
        background: rgba(255,255,255,.10);
    }

        .et-rq-hero-count span,
        .et-rq-hero-count small {
            display: block;
            color: rgba(255,255,255,.68);
            font-size: 9px;
        }

        .et-rq-hero-count strong {
            display: block;
            margin: 2px 0;
            color: #fff;
            font-size: 25px;
            font-weight: 900;
        }

    /* KPI strip */
    .et-rq-kpis {
        display: grid;
        grid-template-columns: repeat(8, minmax(0,1fr));
        gap: 10px;
        margin-bottom: 15px;
    }

    .et-rq-kpi {
        min-width: 0;
        padding: 13px 13px 12px;
        background: #fff;
        border: 1px solid #dce7e5;
        border-top: 3px solid #0f725c;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(12,38,71,.045);
    }

        .et-rq-kpi.blue {
            border-top-color: #195ca8;
        }

        .et-rq-kpi.red {
            border-top-color: #cf4039;
        }

        .et-rq-kpi.amber {
            border-top-color: #dc7a08;
        }

        .et-rq-kpi.purple {
            border-top-color: #6941c6;
        }

        .et-rq-kpi.cyan {
            border-top-color: #0ba5b7;
        }

        .et-rq-kpi.gray {
            border-top-color: #667085;
        }

    .et-rq-kpi-label {
        overflow: hidden;
        color: #667085;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .35px;
        text-overflow: ellipsis;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .et-rq-kpi-value {
        display: block;
        margin-top: 5px;
        color: #15263f;
        font-size: 22px;
        font-weight: 900;
        line-height: 1;
    }

    .et-rq-kpi-foot {
        margin-top: 6px;
        color: #7c8993;
        font-size: 9px;
        line-height: 1.35;
    }

    /* Request lifecycle explainer - once per page, not repeated per request */
    .et-rq-flow {
        margin-bottom: 15px;
        padding: 14px 17px;
        background: #fff;
        border: 1px solid #dce7e5;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(12,38,71,.04);
    }

    .et-rq-flow-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        margin-bottom: 13px;
    }

        .et-rq-flow-head h2 {
            margin: 0;
            color: #102b49;
            font-size: 15px;
        }

        .et-rq-flow-head span {
            color: #74817d;
            font-size: 10px;
        }

    .et-rq-flow-track {
        display: grid;
        grid-template-columns: repeat(7, minmax(0,1fr));
        gap: 0;
    }

    .et-rq-flow-step {
        position: relative;
        min-width: 0;
        padding-top: 27px;
        text-align: center;
    }

        .et-rq-flow-step:before {
            position: absolute;
            top: 9px;
            left: 0;
            width: 100%;
            height: 2px;
            background: #dce7e5;
            content: "";
        }

        .et-rq-flow-step:first-child:before {
            left: 50%;
            width: 50%;
        }

        .et-rq-flow-step:last-child:before {
            width: 50%;
        }

    .et-rq-flow-dot {
        position: absolute;
        z-index: 1;
        top: 2px;
        left: 50%;
        display: flex;
        width: 16px;
        height: 16px;
        align-items: center;
        justify-content: center;
        transform: translateX(-50%);
        color: #fff;
        background: #0f725c;
        border: 3px solid #e8f5f1;
        border-radius: 50%;
    }

    .et-rq-flow-step strong {
        display: block;
        overflow: hidden;
        color: #344054;
        font-size: 10px;
        font-weight: 850;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .et-rq-flow-step small {
        display: block;
        margin-top: 2px;
        color: #8a9692;
        font-size: 8.5px;
    }

    /* Search / sort command bar */
    .et-rq-tools {
        display: grid;
        grid-template-columns: minmax(250px, 1.3fr) 190px 210px minmax(260px,1fr) auto auto;
        gap: 10px;
        align-items: end;
        margin-bottom: 15px;
        padding: 13px;
        background: #fff;
        border: 1px solid #dce7e5;
        border-radius: 14px;
        box-shadow: 0 5px 16px rgba(12,38,71,.045);
    }

        .et-rq-tools .et-field {
            min-width: 0;
        }

    .et-rq-search-wrap {
        position: relative;
    }

        .et-rq-search-wrap:before {
            position: absolute;
            top: 50%;
            left: 11px;
            transform: translateY(-50%);
            color: #84918d;
            font-size: 14px;
            content: "⌕";
        }

        .et-rq-search-wrap .et-input {
            padding-left: 31px;
            font-size: 12px;
        }

    .et-rq-principle {
        min-height: 39px;
        display: flex;
        align-items: center;
        padding: 7px 10px;
        color: #63726d;
        background: #f7faf9;
        border: 1px solid #e2ebe8;
        border-radius: 9px;
        font-size: 10px;
        line-height: 1.45;
    }

    .et-rq-tools .et-btn {
        white-space: nowrap;
    }

    /* Queue frame */
    .et-rq-queue {
        padding: 16px;
        background: #f6f9f8;
        border: 1px solid #dce7e5;
        border-radius: 15px;
    }

    .et-rq-queue-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

        .et-rq-queue-head h2 {
            margin: 0;
            color: #102b49;
            font-size: 18px;
        }

        .et-rq-queue-head p {
            margin: 4px 0 0;
            color: #667085;
            font-size: 11px;
        }

    .et-rq-result-meta {
        color: #667085;
        font-size: 10px;
        white-space: nowrap;
    }

        .et-rq-result-meta strong {
            color: #102b49;
            font-size: 12px;
        }

    /* Thin request cards */
    .et-rq-list {
        display: grid;
        gap: 9px;
    }

    .et-rq-item {
        overflow: hidden;
        background: #fff;
        border: 1px solid #dde7e4;
        border-left: 4px solid #98a2b3;
        border-radius: 11px;
        transition: box-shadow .15s ease, border-color .15s ease;
    }

        .et-rq-item:hover {
            border-color: #c7d9d4;
            box-shadow: 0 7px 17px rgba(12,38,71,.055);
        }

        .et-rq-item.priority {
            border-left-color: #cf4039;
        }

        .et-rq-item.inservice {
            border-left-color: #195ca8;
        }

        .et-rq-item.completed {
            border-left-color: #0f725c;
        }

        .et-rq-item.problem {
            border-left-color: #dc7a08;
        }

    .et-rq-item-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 11px;
        background: #fbfdfc;
        border-bottom: 1px solid #ebf0ee;
    }

    .et-rq-idline {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .et-rq-idline strong {
            color: #102b49;
            font-size: 12px;
        }

        .et-rq-idline span {
            color: #7a8782;
            font-size: 10px;
        }

    .et-rq-priority {
        padding: 3px 7px;
        color: #b42318 !important;
        background: #fef3f2;
        border-radius: 999px;
        font-size: 8.5px !important;
        font-weight: 900;
    }

    .et-rq-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 900;
        white-space: nowrap;
    }

        .et-rq-status.new {
            color: #344054;
            background: #f2f4f7;
        }

        .et-rq-status.routing, .et-rq-status.offered {
            color: #9a6700;
            background: #fff8e7;
        }

        .et-rq-status.assigned, .et-rq-status.enroute, .et-rq-status.pickup, .et-rq-status.dropoff {
            color: #1849a9;
            background: #eff4ff;
        }

        .et-rq-status.completed {
            color: #067647;
            background: #ecfdf3;
        }

        .et-rq-status.problem, .et-rq-status.cancelled {
            color: #b42318;
            background: #fef3f2;
        }

    .et-rq-item-main {
        display: grid;
        grid-template-columns: minmax(175px,.85fr) minmax(330px,1.7fr) minmax(190px,.9fr) minmax(210px,.95fr);
        gap: 14px;
        align-items: center;
        padding: 10px 11px 9px;
    }

    .et-rq-block {
        min-width: 0;
    }

    .et-rq-label {
        display: block;
        margin-bottom: 3px;
        color: #8a9692;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .et-rq-block strong {
        display: block;
        overflow: hidden;
        color: #253b50;
        font-size: 11.5px;
        font-weight: 850;
        line-height: 1.35;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .et-rq-block small {
        display: block;
        overflow: hidden;
        margin-top: 2px;
        color: #74817d;
        font-size: 10px;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .et-rq-route-line {
        display: grid;
        grid-template-columns: minmax(0,1fr) 34px minmax(0,1fr);
        gap: 7px;
        align-items: center;
    }

    .et-rq-route-point {
        min-width: 0;
    }

    .et-rq-route-arrow {
        color: #91a09a;
        font-size: 18px;
        text-align: center;
    }

    .et-rq-service-row,
    .et-rq-assignment-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 4px;
    }

    .et-rq-chip {
        display: inline-flex;
        align-items: center;
        padding: 3px 6px;
        color: #475467;
        background: #f2f4f7;
        border-radius: 999px;
        font-size: 8.5px;
        font-weight: 750;
    }

        .et-rq-chip.assist {
            color: #9a6700;
            background: #fff8e7;
        }

        .et-rq-chip.blue {
            color: #1849a9;
            background: #eff4ff;
        }

    .et-rq-wait {
        display: flex;
        align-items: baseline;
        gap: 3px;
        color: #102b49;
        font-size: 17px;
        font-weight: 900;
    }

        .et-rq-wait small {
            font-size: 9px;
            font-weight: 700;
            color: #667085;
        }

        .et-rq-wait.warn {
            color: #b54708;
        }

        .et-rq-wait.critical {
            color: #b42318;
        }

    .et-rq-item-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
        padding: 0 11px 9px;
    }

        .et-rq-item-actions .et-btn.small {
            min-height: 33px;
            padding: 6px 10px;
            font-size: 10.5px;
        }

    .et-rq-empty {
        min-height: 190px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        color: #7a8782;
        background: #fff;
        border: 1px dashed #ceddd8;
        border-radius: 11px;
        font-size: 11px;
    }

        .et-rq-empty strong {
            color: #344054;
            font-size: 13px;
        }

    /* ========================================================================
       DRAWER / REQUEST DETAILS
       Overrides generic drawer so these styles apply even though drawer is
       appended directly to BODY by transport.core.js.
       ======================================================================== */

    #et-drawer.et-drawer {
        right: -700px;
        width: 660px;
        max-width: 96vw;
        background: #f5f8f7;
        box-shadow: -22px 0 55px rgba(12,38,71,.24);
    }

        #et-drawer.et-drawer.open {
            right: 0;
        }

    #et-drawer .et-drawer-head {
        padding: 17px 19px;
        background: linear-gradient(120deg, #0c2647, #174e76 57%, #0f725c);
    }

    #et-drawer #et-drawer-title {
        font-size: 16px;
        font-weight: 850;
        letter-spacing: -.15px;
    }

    #et-drawer .et-drawer-close {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255,255,255,.11);
        font-size: 23px;
        line-height: 1;
    }

    #et-drawer .et-drawer-body {
        padding: 15px;
    }

    .et-rqd {
        color: #253b50;
        font-size: 12px;
    }

    .et-rqd-summary {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 8px;
        margin-bottom: 11px;
    }

    .et-rqd-stat {
        padding: 10px;
        background: #fff;
        border: 1px solid #dde7e4;
        border-radius: 10px;
    }

        .et-rqd-stat span {
            display: block;
            color: #7b8783;
            font-size: 8px;
            font-weight: 900;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        .et-rqd-stat strong {
            display: block;
            margin-top: 4px;
            color: #102b49;
            font-size: 15px;
            font-weight: 900;
        }

    .et-rqd-section {
        margin-top: 10px;
        padding: 13px;
        background: #fff;
        border: 1px solid #dce7e4;
        border-radius: 11px;
    }

    .et-rqd-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        padding-bottom: 8px;
        color: #102b49;
        border-bottom: 1px solid #edf2f0;
        font-size: 12px;
        font-weight: 900;
    }

        .et-rqd-section-title small {
            color: #7b8783;
            font-size: 9px;
            font-weight: 600;
        }

    .et-rqd-person-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 14px;
    }

    .et-rqd-field {
        min-width: 0;
    }

        .et-rqd-field.wide {
            grid-column: 1 / -1;
        }

        .et-rqd-field span {
            display: block;
            color: #8a9692;
            font-size: 8px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .et-rqd-field strong,
        .et-rqd-field div {
            display: block;
            margin-top: 3px;
            overflow-wrap: anywhere;
            color: #30475a;
            font-size: 11px;
            font-weight: 800;
            line-height: 1.45;
        }

    .et-rqd-route {
        display: grid;
        grid-template-columns: minmax(0,1fr) 42px minmax(0,1fr);
        gap: 8px;
        align-items: center;
    }

    .et-rqd-route-box {
        min-width: 0;
        padding: 10px;
        background: #f8fbfa;
        border: 1px solid #e4ece9;
        border-radius: 9px;
    }

        .et-rqd-route-box span {
            display: block;
            color: #85918d;
            font-size: 8px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .et-rqd-route-box strong {
            display: block;
            margin-top: 3px;
            color: #243b50;
            font-size: 11px;
            line-height: 1.35;
        }

        .et-rqd-route-box small {
            display: block;
            margin-top: 3px;
            color: #6f7d78;
            font-size: 9px;
            line-height: 1.4;
        }

    .et-rqd-route-arrow {
        text-align: center;
        color: #91a09a;
        font-size: 20px;
    }

    .et-rqd-assistance {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 9px;
    }

    .et-rqd-assigned {
        display: grid;
        grid-template-columns: 42px minmax(0,1fr) auto;
        gap: 10px;
        align-items: center;
        padding: 10px;
        background: #eff5fb;
        border: 1px solid #d8e4f0;
        border-radius: 9px;
    }

    .et-rqd-vehicle-icon {
        display: flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        background: #fff;
        border-radius: 9px;
        font-size: 21px;
    }

    .et-rqd-assigned span {
        display: block;
        color: #7b8783;
        font-size: 8px;
        text-transform: uppercase;
    }

    .et-rqd-assigned strong {
        display: block;
        margin-top: 2px;
        color: #1f3850;
        font-size: 12px;
    }

    .et-rqd-assigned small {
        display: block;
        margin-top: 2px;
        color: #667085;
        font-size: 9px;
    }

    .et-rqd-provider {
        padding-left: 10px;
        border-left: 1px solid #d6e2ed;
        text-align: right;
    }

    .et-rqd-offers {
        display: grid;
        gap: 7px;
    }

    .et-rqd-offer {
        display: grid;
        grid-template-columns: minmax(0,1.4fr) 85px 65px auto;
        gap: 8px;
        align-items: center;
        padding: 9px;
        background: #f9fbfb;
        border: 1px solid #e1e9e7;
        border-radius: 9px;
    }

    .et-rqd-offer-vehicle {
        display: flex;
        min-width: 0;
        gap: 8px;
        align-items: center;
    }

        .et-rqd-offer-vehicle .emoji {
            font-size: 19px;
        }

        .et-rqd-offer-vehicle strong {
            display: block;
            color: #243b50;
            font-size: 10.5px;
        }

        .et-rqd-offer-vehicle small {
            display: block;
            margin-top: 2px;
            color: #74817d;
            font-size: 9px;
        }

    .et-rqd-offer-metric span {
        display: block;
        color: #8a9692;
        font-size: 7.5px;
        text-transform: uppercase;
    }

    .et-rqd-offer-metric strong {
        display: block;
        margin-top: 2px;
        color: #30475a;
        font-size: 10px;
    }

    .et-rqd-history {
        position: relative;
        padding-left: 23px;
    }

        .et-rqd-history:before {
            position: absolute;
            top: 7px;
            bottom: 7px;
            left: 8px;
            width: 2px;
            background: #dfe8e5;
            content: "";
        }

    .et-rqd-history-item {
        position: relative;
        padding: 0 0 12px 5px;
    }

        .et-rqd-history-item:last-child {
            padding-bottom: 0;
        }

    .et-rqd-history-dot {
        position: absolute;
        top: 3px;
        left: -21px;
        width: 10px;
        height: 10px;
        background: #0f725c;
        border: 2px solid #e9f5f1;
        border-radius: 50%;
    }

    .et-rqd-history-item strong {
        display: block;
        color: #30475a;
        font-size: 10.5px;
    }

    .et-rqd-history-item span {
        display: block;
        margin-top: 2px;
        color: #7a8782;
        font-size: 9px;
    }

    .et-rqd-history-item p {
        margin: 3px 0 0;
        color: #667085;
        font-size: 9.5px;
        line-height: 1.45;
    }

    .et-rqd-empty {
        padding: 17px;
        color: #7a8782;
        text-align: center;
        background: #f9fbfa;
        border: 1px dashed #d6e2de;
        border-radius: 9px;
        font-size: 10px;
    }

    @@media (max-width: 1450px) {
        .et-rq-kpis {
            grid-template-columns: repeat(4,minmax(0,1fr));
        }

        .et-rq-tools {
            grid-template-columns: minmax(250px,1fr) 180px 195px auto auto;
        }

        .et-rq-principle {
            display: none;
        }
    }

    @@media (max-width: 1150px) {
        .et-rq-item-main {
            grid-template-columns: 1fr 1.45fr;
        }

            .et-rq-item-main .et-rq-service {
                grid-column: 1;
            }

            .et-rq-item-main .et-rq-dispatch {
                grid-column: 2;
            }

        .et-rq-tools {
            grid-template-columns: 1fr 180px 195px;
        }

            .et-rq-tools .et-rq-principle {
                display: none;
            }

            .et-rq-tools .et-btn {
                width: 100%;
            }
    }

    @@media (max-width: 820px) {
        .et-rq-hero {
            align-items: stretch;
            flex-direction: column;
        }

        .et-rq-hero-count {
            width: 100%;
            text-align: left;
        }

        .et-rq-kpis {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .et-rq-flow-track {
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 10px;
        }

        .et-rq-flow-step:before {
            display: none;
        }

        .et-rq-tools {
            grid-template-columns: 1fr;
        }

        .et-rq-item-main {
            grid-template-columns: 1fr;
        }

            .et-rq-item-main .et-rq-service,
            .et-rq-item-main .et-rq-dispatch {
                grid-column: auto;
            }

        .et-rq-route-line {
            grid-template-columns: 1fr;
        }

        .et-rq-route-arrow {
            display: none;
        }

        .et-rq-item-actions {
            justify-content: flex-start;
        }

        .et-rq-queue-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .et-rqd-summary {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .et-rqd-route {
            grid-template-columns: 1fr;
        }

        .et-rqd-route-arrow {
            transform: rotate(90deg);
        }

        .et-rqd-offer {
            grid-template-columns: 1fr 1fr;
        }

            .et-rqd-offer .et-btn {
                grid-column: 1 / -1;
            }
    }
</style>

<div class="et-page et-requests-v2">

    @Html.Partial(
        "~/Areas/ElectionTransport/Views/Shared/_TransportNav.cshtml",
        Model
    )

    @Html.AntiForgeryToken()


    <section class="et-shell et-rq-kpis">
        <div class="et-rq-kpi">
            <span class="et-rq-kpi-label">Total requests</span>
            <strong id="et-rq-stat-total" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">All requests in this constituency</div>
        </div>
        <div class="et-rq-kpi blue">
            <span class="et-rq-kpi-label">Needs routing</span>
            <strong id="et-rq-stat-routing" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">New, routing or no vehicle</div>
        </div>
        <div class="et-rq-kpi cyan">
            <span class="et-rq-kpi-label">In service</span>
            <strong id="et-rq-stat-service" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">Assigned through drop-off</div>
        </div>
        <div class="et-rq-kpi">
            <span class="et-rq-kpi-label">Completed</span>
            <strong id="et-rq-stat-completed" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">Transport service completed</div>
        </div>
        <div class="et-rq-kpi purple">
            <span class="et-rq-kpi-label">Priority assistance</span>
            <strong id="et-rq-stat-priority" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">Priority 1–2 / assisted requests</div>
        </div>
        <div class="et-rq-kpi red">
            <span class="et-rq-kpi-label">No vehicle</span>
            <strong id="et-rq-stat-novehicle" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">Requests requiring intervention</div>
        </div>
        <div class="et-rq-kpi amber">
            <span class="et-rq-kpi-label">Passengers open</span>
            <strong id="et-rq-stat-passengers" class="et-rq-kpi-value">0</strong>
            <div class="et-rq-kpi-foot">People in active/open requests</div>
        </div>
        <div class="et-rq-kpi gray">
            <span class="et-rq-kpi-label">Average wait</span>
            <strong id="et-rq-stat-wait" class="et-rq-kpi-value">0 min</strong>
            <div class="et-rq-kpi-foot">Average wait for open requests</div>
        </div>
    </section>

    <section class="et-shell et-rq-flow">
        <div class="et-rq-flow-head">
            <h2>Transport request life cycle</h2>
            <span>One shared operating workflow for dispatch staff and drivers</span>
        </div>

        <div class="et-rq-flow-track">
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>Request</strong><small>Received</small></div>
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>Match</strong><small>Vehicle search</small></div>
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>Assigned</strong><small>Driver accepts</small></div>
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>En Route</strong><small>To pickup</small></div>
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>Picked Up</strong><small>Passenger onboard</small></div>
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>Drop-off</strong><small>Station reached</small></div>
            <div class="et-rq-flow-step"><i class="et-rq-flow-dot"></i><strong>Complete</strong><small>Service closed</small></div>
        </div>
    </section>

    <section class="et-shell et-rq-tools">
        <div class="et-field">
            <label for="et-request-search">Search requests</label>
            <div class="et-rq-search-wrap">
                <input id="et-request-search"
                       class="et-input"
                       type="text"
                       autocomplete="off"
                       placeholder="Request no, name, mobile, pickup, station, vehicle, driver…" />
            </div>
        </div>

        <div class="et-field">
            <label for="et-request-status-filter">Request status</label>
            <select id="et-request-status-filter" class="et-select">
                <option value="">All requests</option>
                <option value="NEW">New</option>
                <option value="ROUTING">Routing</option>
                <option value="OFFERED">Vehicle offered</option>
                <option value="ASSIGNED">Assigned</option>
                <option value="DRIVER_EN_ROUTE">Driver en route</option>
                <option value="PICKED_UP">Picked up</option>
                <option value="DROPPED_OFF">Dropped off</option>
                <option value="COMPLETED">Completed</option>
                <option value="NO_VEHICLE">No vehicle</option>
                <option value="CANCELLED">Cancelled</option>
            </select>
        </div>

        <div class="et-field">
            <label for="et-request-sort">Sort by</label>
            <select id="et-request-sort" class="et-select">
                <option value="waiting-desc">Longest waiting first</option>
                <option value="priority">Priority first</option>
                <option value="newest">Newest request first</option>
                <option value="oldest">Oldest request first</option>
                <option value="passengers-desc">Most passengers first</option>
                <option value="status">Status</option>
            </select>
        </div>

        <div class="et-rq-principle">
            <strong style="margin-right:5px;color:#30475a;">Smart dispatch:</strong>
            nearest online eligible vehicle · sufficient seats · station alignment · no active conflicting request
        </div>

        <button id="et-refresh-requests"
                class="et-btn navy"
                type="button">
            <i class="fa fa-refresh"></i>
            Refresh
        </button>
        <a class="et-btn primary"
           target="_blank"
           href="@Url.Action("Request", "PublicTransport", new { area = "ElectionTransport", contextId = Model.ElectionContextId })">
            + Public request
        </a>
    </section>

    <section class="et-shell et-rq-queue">
        <div class="et-rq-queue-head">
            <div>
                <h2>Transport request & dispatch queue</h2>
                <p>Compact operational view showing who needs transport, route, assistance, assignment, status and waiting time.</p>
            </div>
            <div class="et-rq-result-meta">
                Showing <strong id="et-request-visible-count">0</strong> of
                <strong id="et-request-total-count">0</strong>
            </div>
        </div>

        <div id="et-requests-body" class="et-rq-list">
            <div class="et-rq-empty">
                <strong>Loading request queue…</strong>
                <span>Retrieving requests and dispatch information.</span>
            </div>
        </div>
    </section>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script>
    <script src="@Url.Content("~/Scripts/ElectionTransport/transport.requests.js")"></script>
    <script>
        ElectionTransport.Requests.init({
            contextId: @Model.ElectionContextId,
            refreshSeconds: @Model.RefreshSeconds,
            requestsUrl: '@Url.Action("Requests", "TransportApi", new { area = "ElectionTransport" })',
            requestDetailsUrl: '@Url.Action("RequestDetails", "TransportApi", new { area = "ElectionTransport" })',
            routeUrl: '@Url.Action("RouteRequest", "TransportApi", new { area = "ElectionTransport" })',
            acceptUrl: '@Url.Action("AcceptDispatch", "TransportApi", new { area = "ElectionTransport" })',
            statusUrl: '@Url.Action("UpdateRequestStatus", "TransportApi", new { area = "ElectionTransport" })'
        });
    </script>
}
