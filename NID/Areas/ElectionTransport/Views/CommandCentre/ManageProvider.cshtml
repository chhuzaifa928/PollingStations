@model NID.Areas.ElectionTransport.Models.ProviderManageViewModel
@{ ViewBag.Title = Model.ProviderId.HasValue ? "Edit Provider / Influencer" : "Add Provider / Influencer"; var context=ViewBag.Context as NID.Areas.ElectionTransport.Models.ElectionContextDto; }
@Html.Partial("~/Areas/ElectionTransport/Views/Shared/_TransportAssets.cshtml")
<div class="et-page">
<div class="et-public-header"><h1>@ViewBag.Title</h1><p>@(context==null?"Election transport provider":context.DisplayText) · Record the promise separately from actual vehicle registration so fulfilment can be measured.</p></div>
<div class="et-card et-form-card">@using(Html.BeginForm("ManageProvider","CommandCentre",new { area="ElectionTransport" },FormMethod.Post,new { autocomplete="off" })) { @Html.AntiForgeryToken() @Html.HiddenFor(x=>x.ProviderId) @Html.HiddenFor(x=>x.ElectionContextId)
<div class="et-form-section">@Html.ValidationSummary(false)<h3>Provider profile</h3><div class="et-form-grid">
<div class="et-form-group et-col-6">@Html.LabelFor(x=>x.ProviderName)@Html.TextBoxFor(x=>x.ProviderName,new { @class="et-input" })@Html.ValidationMessageFor(x=>x.ProviderName,null,new { @class="et-validation" })</div>
<div class="et-form-group et-col-3">@Html.LabelFor(x=>x.ProviderType)@Html.DropDownListFor(x=>x.ProviderType,new[]{new SelectListItem{Value="Influencer",Text="Influencer"},new SelectListItem{Value="Local Organizer",Text="Local Organizer"},new SelectListItem{Value="Donor",Text="Donor"},new SelectListItem{Value="Volunteer",Text="Volunteer"},new SelectListItem{Value="Union",Text="Union"},new SelectListItem{Value="Community Organization",Text="Community Organization"},new SelectListItem{Value="Other",Text="Other"}},new { @class="et-select" })</div>
<div class="et-form-group et-col-3">@Html.LabelFor(x=>x.Area)@Html.TextBoxFor(x=>x.Area,new { @class="et-input" })</div>
<div class="et-form-group et-col-3">@Html.LabelFor(x=>x.Mobile)@Html.TextBoxFor(x=>x.Mobile,new { @class="et-input" })</div><div class="et-form-group et-col-3">@Html.LabelFor(x=>x.AlternateMobile)@Html.TextBoxFor(x=>x.AlternateMobile,new { @class="et-input" })</div>
<div class="et-form-group et-col-3">@Html.LabelFor(x=>x.CandidateId)@Html.DropDownListFor(x=>x.CandidateId,Model.Candidates,"Not linked",new { @class="et-select" })</div><div class="et-form-group et-col-3">@Html.LabelFor(x=>x.PartyId)@Html.DropDownListFor(x=>x.PartyId,Model.Parties,"Not linked",new { @class="et-select" })</div>
<div class="et-form-group et-col-12">@Html.LabelFor(x=>x.Address)@Html.TextAreaFor(x=>x.Address,new { @class="et-textarea",rows=2 })</div></div></div>
<div class="et-form-section"><h3>Vehicle promise / commitment</h3><div class="et-form-grid"><div class="et-form-group et-col-3">@Html.LabelFor(x=>x.PromisedQuantity)@Html.TextBoxFor(x=>x.PromisedQuantity,new { @class="et-input",type="number" })</div><div class="et-form-group et-col-3">@Html.LabelFor(x=>x.CommitmentPollingStationId)@Html.DropDownListFor(x=>x.CommitmentPollingStationId,Model.PollingStations,"Constituency-wide commitment",new { @class="et-select" })</div><div class="et-form-group et-col-4">@Html.LabelFor(x=>x.CommitmentVehicleTypeId)@Html.DropDownListFor(x=>x.CommitmentVehicleTypeId,Model.VehicleTypes,"Mixed vehicle types",new { @class="et-select" })</div><div class="et-form-group et-col-12">@Html.LabelFor(x=>x.Remarks)@Html.TextAreaFor(x=>x.Remarks,new { @class="et-textarea",rows=3 })</div><div class="et-form-group et-col-6"><label class="et-checkbox">@Html.CheckBoxFor(x=>x.IsVerified) Provider verified</label></div><div class="et-form-group et-col-6"><label class="et-checkbox">@Html.CheckBoxFor(x=>x.IsActive) Active provider</label></div></div></div>
<div class="et-form-actions"><a class="et-btn light" href="@Url.Action("Providers","CommandCentre",new { area="ElectionTransport",contextId=Model.ElectionContextId })">Cancel</a><button type="submit" class="et-btn primary">Save provider and commitment</button></div> }</div>
</div>
@section scripts { <script src="@Url.Content("~/Scripts/ElectionTransport/transport.core.js")"></script> }
