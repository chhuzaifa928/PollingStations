@model NID.Models.DashboardViewModel

@{
    ViewBag.Title = "Election Day Dashboard";
    Layout = "~/Views/Shared/_EconomicUnits.cshtml";
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Font Awesome -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet">
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
}
<style>


    body {
        background: #f4f6f9;
    }

    .navbar {
        background: #006A4E;
    }

    .navbar-brand {
        color: white !important;
        font-weight: bold;
    }

    .footer {
        margin-top: 40px;
        background: #006A4E;
        color: white;
        padding: 15px;
        text-align: center;
    }

    .card {
        border-radius: 10px;
    }
</style>
<div class="container-fluid mt-3">

    <!-- ===================== DASHBOARD HEADER ===================== -->
    <div class="row mb-3">

        <div class="col-md-8">
            <h2 class="text-success">
                <i class="fa fa-university"></i>
                Pakistan Election Management System
            </h2>

            <small class="text-muted">
                Election Day Transport & Incident Monitoring Dashboard
            </small>
        </div>

        <div class="col-md-4 text-end">
            <h5>@DateTime.Now.ToString("dd MMM yyyy")</h5>
            <span class="badge bg-success">
                LIVE
            </span>
        </div>

    </div>

    <!-- ===================== KPI CARDS ===================== -->

    <div class="row">

        <div class="col-md-2">

            <div class="card text-white bg-primary mb-3">

                <div class="card-body">

                    <h2>@Model.TotalVehicles</h2>

                    <p>Total Vehicles</p>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card text-white bg-success mb-3">

                <div class="card-body">

                    <h2>@Model.ActiveVehicles</h2>

                    <p>Active Vehicles</p>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card text-white bg-warning mb-3">

                <div class="card-body">

                    <h2>@Model.TotalPollingStations</h2>

                    <p>Polling Stations</p>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card text-white bg-danger mb-3">

                <div class="card-body">

                    <h2>@Model.TotalIncidents</h2>

                    <p>Incidents</p>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card text-white bg-info mb-3">

                <div class="card-body">

                    <h2>@Model.CompletedTrips</h2>

                    <p>Trips</p>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card text-white bg-secondary mb-3">

                <div class="card-body">

                    <h2>@Model.TotalPickedVoters</h2>

                    <p>Voters Picked</p>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================== VEHICLES ===================== -->

    <div class="card mt-3">

        <div class="card-header bg-success text-white">

            <h4>
                Active Transport Vehicles
            </h4>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>Vehicle</th>

                        <th>Driver</th>

                        <th>Route</th>

                        <th>Polling Station</th>

                        <th>Passengers</th>

                        <th>Trips</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Vehicles)
                    {

                        <tr>

                            <td>@item.VehicleNo</td>

                            <td>@item.DriverName</td>

                            <td>@item.RouteName</td>

                            <td>@item.PollingStation</td>

                            <td>

                                @item.Passengers /

                                @item.Capacity

                            </td>

                            <td>

                                @item.CompletedTrips

                            </td>

                            <td>

                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Returning
                                    </span>
                                }

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- ===================== POLLING STATIONS ===================== -->

    <div class="row mt-4">

        <div class="col-md-6">

            <div class="card">

                <div class="card-header bg-primary text-white">

                    Polling Stations

                </div>

                <div class="card-body">

                    <table class="table table-striped">

                        <thead>

                            <tr>

                                <th>Station</th>

                                <th>Expected</th>

                                <th>Picked</th>

                                <th>Waiting</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var p in Model.PollingStations)
                            {

                                <tr>

                                    <td>@p.StationCode</td>

                                    <td>@p.ExpectedVoters</td>

                                    <td>@p.PickedVoters</td>

                                    <td>@p.WaitingVoters</td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- ===================== INCIDENTS ===================== -->

        <div class="col-md-6">

            <div class="card">

                <div class="card-header bg-danger text-white">

                    Election Incidents

                </div>

                <div class="card-body">

                    <table class="table table-hover">

                        <thead>

                            <tr>

                                <th>Station</th>

                                <th>Incident</th>

                                <th>Severity</th>

                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var i in Model.Incidents)
                            {

                                <tr>

                                    <td>@i.PollingStation</td>

                                    <td>@i.IncidentType</td>

                                    <td>@i.Severity</td>

                                    <td>

                                        @if (i.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">
                                                Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                In Progress
                                            </span>
                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        Great! Now let's add the Live Election Transport Map.

        At the end of this step, you will have an interactive map displayed on your dashboard.

        Step 8 – Add the Live Map Card
        Open:

        Views
        Dashboard
        Index.cshtml

        Locate the KPI Cards section. Immediately below the KPI cards, add the following code.

        <!-- ==================== LIVE TRANSPORT MAP ==================== -->

        <div class="card shadow mt-3">

            <div class="card-header bg-success text-white">

                <h4>
                    <i class="fa fa-map"></i>
                    Live Election Transport Map
                </h4>

            </div>

            <div class="card-body">

                <div id="electionMap"
                     style="height:600px;width:100%;border-radius:8px;">

                </div>

            </div>

        </div>
    </div>

</div>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        // Islamabad
        var map = L.map('electionMap').setView([33.6844, 73.0479], 12);

        // OpenStreetMap tiles
        L.tileLayer(
            'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
            {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap Contributors'
            }
        ).addTo(map);

    });

</script>

