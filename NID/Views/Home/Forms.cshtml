@{
    Layout = "~/Views/Shared/_EconomicUnits.cshtml";
    <style>

        .c2 {
            padding: 5px;
        }
        table{
            font-size:16px;
        }
    </style>
}

<div class="row">
    <div class="col-sm-12">
        <h2 class="mb-4">Election-Related Forms in Pakistan</h2>
        <table class="table table-bordered table-striped" style="background-color:white;">
            <thead class="bg-primary">
                <tr>
                    <th>Category</th>
                    <th>Form Number</th>
                    <th>Form Name / Purpose</th>
                    <th>Links</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td rowspan="4">Voter Registration</td>
                    <td>Form-21 (A)</td>
                    <td>Application for new voter registration</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-22 (B)</td>
                    <td>Application for correction of voter details</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-23 (C)</td>
                    <td>Application for objection to inclusion/exclusion of name in electoral roll</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-24 (D)</td>
                    <td>Application for deletion of name from electoral roll</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td rowspan="3">Candidate Nomination</td>
                    <td>Form-32</td>
                    <td>Nomination Paper for contesting general elections</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-33</td>
                    <td>Statement of assets and liabilities of the candidate</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-34</td>
                    <td>Return of election expenses by the candidate</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td rowspan="5">Election Results</td>
                    <td>Form-45</td>
                    <td>
                        Result of the Count – prepared by the Presiding Officer at the polling station
                    </td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-46</td>
                    <td>Ballot Paper Account – number of ballot papers used, unused, spoiled, etc.</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-47</td>
                    <td>Provisional Consolidated Statement of Result of the Count (prepared by RO)</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-48</td>
                    <td>
                        Consolidated Statement of Result of the Count
                    </td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-49</td>
                    <td>
                        Final Result of the Election (Returned Candidate Notification)
                    </td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td rowspan="2">Political Parties</td>
                    <td>Form-65</td>
                    <td>Application for party enlistment with ECP</td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
                <tr>
                    <td>Form-66</td>
                    <td>
                        Annual statement of assets and liabilities of a political party
                    </td>
                    <td><button class="btn btn-primary">Download</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>



@section scripts{
    <script src="~/script/js/jquery.dataTables.min.js"></script>
  

}
