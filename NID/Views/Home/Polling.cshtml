            });
        }, 120);
    }
    function setSchemeLoading(isLoading) {
        elements.schemeLoadingState.style.display =
            isLoading ? "flex" : "none";

        if (isLoading) {
            elements.schemeContent.style.display = "none";
            elements.schemeEmptyState.style.display = "none";
            elements.schemeErrorState.style.display = "none";
        }
    }
    function renderPollingScheme(record, rows) {
        var totals = rows.reduce(
            function (result, row) {
                var rowTotal = row.Voter;

                if (
                    rowTotal === 0 &&
                    (row.MVoter > 0 || row.FVoter > 0)
                ) {
                    rowTotal =
                        row.MVoter +
                        row.FVoter;
                }

                result.total += rowTotal;
                result.male += row.MVoter;
                result.female += row.FVoter;

                return result;
            },
            {
                total: 0,
                male: 0,
                female: 0
            }
        );

        if (
            totals.total === 0 &&
            (totals.male > 0 || totals.female > 0)
        ) {
            totals.total =
                totals.male +
                totals.female;
        }

        var femaleShare =
            totals.total > 0
                ? (totals.female / totals.total) * 100
                : 0;

        elements.schemeAreaCount.textContent =
            formatNumber(rows.length);

        elements.schemeTotalVoters.textContent =
            formatNumber(totals.total);

        elements.schemeMaleVoters.textContent =
            formatNumber(totals.male);

        elements.schemeFemaleVoters.textContent =
            formatNumber(totals.female);

        elements.schemeGenderRatio.textContent =
            femaleShare.toFixed(1) + "%";

        elements.schemeRecordBadge.textContent =
            formatNumber(rows.length) +
            (rows.length === 1
                ? " area"
                : " areas");

        elements.schemeContent.style.display = "block";
        elements.schemeEmptyState.style.display = "none";
        elements.schemeErrorState.style.display = "none";

        renderSchemeTable(rows);
        renderSchemeGenderChart(totals);
        renderSchemeAreaChart(rows);
    }
    function renderSchemeTable(rows) {
        if (!rows.length) {
            elements.schemeTableBody.innerHTML =
                '<tr>' +
                '<td colspan="8">' +
                '<div class="ems-no-data">' +
                'No polling areas matched the search.' +
                '</div>' +
                '</td>' +
                '</tr>';

            return;
        }

        var html = "";

        rows.forEach(function (row, index) {
            var totalVoters = row.Voter;

            if (
                totalVoters === 0 &&
                (row.MVoter > 0 || row.FVoter > 0)
            ) {
                totalVoters =
                    row.MVoter +
                    row.FVoter;
            }

            var malePercentage =
                totalVoters > 0
                    ? (row.MVoter / totalVoters) * 100
                    : 0;

            var femalePercentage =
                totalVoters > 0
                    ? (row.FVoter / totalVoters) * 100
                    : 0;

            html +=
                '<tr>' +

                '<td>' +
                escapeHtml(
                    String(index + 1)
                ) +
                '</td>' +

                '<td>' +
                '<span class="ems-scheme-seat-badge">' +
                escapeHtml(
                    displayValue(row.Seat)
                ) +
                '</span>' +
                '</td>' +

                '<td>' +
                '<div class="ems-scheme-area-name">' +
                escapeHtml(
                    displayValue(
                        row.Area,
                        "Area not specified"
                    )
                ) +
                '</div>' +
                '</td>' +

                '<td class="ems-number-column">' +
                escapeHtml(
                    displayBlockNumber(row.Bl)
                ) +
                '</td>' +

                '<td class="ems-number-column">' +
                escapeHtml(
                    formatNumber(row.MVoter)
                ) +
                '</td>' +

                '<td class="ems-number-column">' +
                escapeHtml(
                    formatNumber(row.FVoter)
                ) +
                '</td>' +

                '<td class="ems-number-column">' +
                '<span class="ems-scheme-voter-total">' +
                escapeHtml(
                    formatNumber(totalVoters)
                ) +
                '</span>' +
                '</td>' +

                '<td>' +
                buildGenderDistributionBars(
                    malePercentage,
                    femalePercentage
                ) +
                '</td>' +

                '</tr>';
        });

        elements.schemeTableBody.innerHTML = html;
    }
    function buildGenderDistributionBars(
        malePercentage,
        femalePercentage
    ) {
        return (
            '<div class="ems-scheme-gender-bars">' +

            '<div class="ems-scheme-bar-labels">' +
            '<span>Male ' +
            malePercentage.toFixed(1) +
            '%</span>' +

            '<span>Female ' +
            femalePercentage.toFixed(1) +
            '%</span>' +
            '</div>' +

            '<div class="ems-scheme-bar">' +
            '<div class="ems-scheme-bar-fill ems-scheme-bar-male" ' +
            'style="width:' +
            Math.min(100, malePercentage) +
            '%;"></div>' +
            '</div>' +

            '<div class="ems-scheme-bar">' +
            '<div class="ems-scheme-bar-fill ems-scheme-bar-female" ' +
            'style="width:' +
            Math.min(100, femalePercentage) +
            '%;"></div>' +
            '</div>' +

            '</div>'
        );
    }
    function displayBlockNumber(value) {
        if (
            value === null ||
            value === undefined ||
            String(value).trim() === ""
        ) {
            return "Not available";
        }

        return String(value);
    }
    function renderSchemeGenderChart(totals) {
        if (state.schemeGenderChart) {
            state.schemeGenderChart.destroy();
            state.schemeGenderChart = null;
        }

        var canvas =
            document.getElementById("schemeGenderChart");

        if (!canvas) {
            return;
        }

        state.schemeGenderChart = new Chart(
            canvas.getContext("2d"),
            {
                type: "doughnut",

                data: {
                    labels: [
                        "Male Voters",
                        "Female Voters"
                    ],

                    datasets: [
                        {
                            data: [
                                totals.male,
                                totals.female
                            ],

                            backgroundColor: [
                                "#2670c8",
                                "#c14f87"
                            ],

                            borderColor: "#ffffff",
                            borderWidth: 4,
                            hoverOffset: 8
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "67%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                padding: 18,
                                font: {
                                    size: 11,
                                    weight: "600"
                                }
                            }
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    var value =
                                        context.parsed || 0;

                                    var total =
                                        totals.male +
                                        totals.female;

                                    var percentage =
                                        total > 0
                                            ? (
                                                value /
                                                total *
                                                100
                                            ).toFixed(1)
                                            : "0.0";

                                    return (
                                        context.label +
                                        ": " +
                                        formatNumber(value) +
                                        " (" +
                                        percentage +
                                        "%)"
                                    );
                                }
                            }
                        }
                    }
                }
            }
        );
    }
    function renderSchemeAreaChart(rows) {
        if (state.schemeAreaChart) {
            state.schemeAreaChart.destroy();
            state.schemeAreaChart = null;
        }

        var canvas =
            document.getElementById("schemeAreaChart");

        if (!canvas) {
            return;
        }

        var chartRows = rows
            .map(function (row) {
                return {
                    area: displayValue(
                        row.Area,
                        "Unnamed Area"
                    ),

                    male: row.MVoter,
                    female: row.FVoter,

                    total:
                        row.Voter > 0
                            ? row.Voter
                            : row.MVoter + row.FVoter
                };
            })
            .sort(function (a, b) {
                return b.total - a.total;
            })
            .slice(0, 15);

        state.schemeAreaChart = new Chart(
            canvas.getContext("2d"),
            {
                type: "bar",

                data: {
                    labels: chartRows.map(
                        function (row) {
                            return truncateText(
                                row.area,
                                35
                            );
                        }
                    ),

                    datasets: [
                        {
                            label: "Male Voters",

                            data: chartRows.map(
                                function (row) {
                                    return row.male;
                                }
                            ),

                            backgroundColor:
                                "rgba(38, 112, 200, .82)",

                            borderColor:
                                "#2670c8",

                            borderWidth: 1,
                            borderRadius: 5
                        },
                        {
                            label: "Female Voters",

                            data: chartRows.map(
                                function (row) {
                                    return row.female;
                                }
                            ),

                            backgroundColor:
                                "rgba(193, 79, 135, .82)",

                            borderColor:
                                "#c14f87",

                            borderWidth: 1,
                            borderRadius: 5
                        }
                    ]
                },

                options: {
                    indexAxis: "y",
                    responsive: true,
                    maintainAspectRatio: false,

                    interaction: {
                        mode: "index",
                        intersect: false
                    },

                    scales: {
                        x: {
                            stacked: true,
                            beginAtZero: true,

                            grid: {
                                color:
                                    "rgba(50, 65, 90, .07)"
                            },

                            ticks: {
                                callback: function (value) {
                                    return Number(value)
                                        .toLocaleString(
                                            "en-US"
                                        );
                                }
                            }
                        },

                        y: {
                            stacked: true,

                            grid: {
                                display: false
                            },

                            ticks: {
                                font: {
                                    size: 10
                                }
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                padding: 18,
                                font: {
                                    size: 11,
                                    weight: "600"
                                }
                            }
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return (
                                        context.dataset.label +
                                        ": " +
                                        formatNumber(
                                            context.parsed.x
                                        )
                                    );
                                },

                                footer: function (items) {
                                    var total = items.reduce(
                                        function (
                                            result,
                                            item
                                        ) {
                                            return (
                                                result +
                                                item.parsed.x
                                            );
                                        },
                                        0
                                    );

                                    return (
                                        "Total: " +
                                        formatNumber(total)
                                    );
                                }
                            }
                        }
                    }
                }
            }
        );
    }
    function truncateText(value, maximumLength) {
        var text = String(value || "");

        if (text.length <= maximumLength) {
            return text;
        }

        return text.substring(
            0,
            maximumLength - 1
        ) + "…";
    }
    function filterPollingSchemeTable() {
        var searchText =
            String(
                elements.schemeAreaSearch.value || ""
            )
                .trim()
                .toLowerCase();

        if (!searchText) {
            renderSchemeTable(
                state.schemeData
            );

            return;
        }

        var filteredRows =
            state.schemeData.filter(
                function (row) {
                    var searchableText = [
                        row.Area,
                        row.Seat,
                        row.Sr,
                        row.Bl
                    ]
                        .join(" ")
                        .toLowerCase();

                    return (
                        searchableText.indexOf(
                            searchText
                        ) >= 0
                    );
                }
            );

        renderSchemeTable(filteredRows);
    }
    function showSchemeEmptyState(record) {
        destroySchemeCharts();

        elements.schemeContent.style.display = "none";
        elements.schemeErrorState.style.display = "none";
        elements.schemeEmptyState.style.display = "flex";

        elements.schemeRecordBadge.textContent =
            "No areas";

        elements.schemeHeading.textContent =
            displayValue(
                record.PollingStation || record.Station,
                "Polling Station Profile"
            );
    }
    function showSchemeError(message) {
        destroySchemeCharts();

        elements.schemeContent.style.display = "none";
        elements.schemeEmptyState.style.display = "none";
        elements.schemeErrorState.style.display = "flex";

        elements.schemeErrorState.innerHTML =
            '<div>' +
            '<strong style="display:block;margin-bottom:7px;">' +
            'Unable to load polling scheme' +
            '</strong>' +

            '<span>' +
            escapeHtml(message) +
            '</span>' +
            '</div>';

        elements.schemeRecordBadge.textContent =
            "Load failed";
    }

    function closePollingScheme() {
        ++state.schemeRequestNumber;

        state.schemeData = [];

        destroySchemeCharts();

        elements.pollingSchemeSection.style.display = "none";
        elements.schemeContent.style.display = "none";
        elements.schemeEmptyState.style.display = "none";
        elements.schemeErrorState.style.display = "none";
        elements.schemeLoadingState.style.display = "none";
        elements.schemeAreaSearch.value = "";
    }
    function destroySchemeCharts() {
        if (state.schemeGenderChart) {
            state.schemeGenderChart.destroy();
            state.schemeGenderChart = null;
        }

        if (state.schemeAreaChart) {
            state.schemeAreaChart.destroy();
            state.schemeAreaChart = null;
        }
    }
    window.ElectionMap = {
        showDetails: function (recordIndex) {
            var record = state.allData.find(
                function (item) {
                    return (
                        item.__index ===
                        recordIndex
                    );
                }
            );

            if (!record) {
                return;
            }

            showStationDetails(record);

            var markerRecord =
                state.markerRecords.find(
                    function (item) {
                        return (
                            item.record.__index ===
                            recordIndex
                        );
                    }
                );

            if (markerRecord) {
                state.markerCluster.zoomToShowLayer(
                    markerRecord.marker,
                    function () {
                        markerRecord.marker.openPopup();
                    }
                );
            }
        },

        loadScheme: function (recordIndex) {
            var record = state.allData.find(
                function (item) {
                    return (
                        item.__index ===
                        recordIndex
                    );
                }
            );

            if (!record) {
                showToast(
                    "The polling station record could not be found.",
                    "error"
                );

                return;
            }

            showStationDetails(record);

            var markerRecord =
                state.markerRecords.find(
                    function (item) {
                        return (
                            item.record.__index ===
                            recordIndex
                        );
                    }
                );

            if (markerRecord) {
                markerRecord.marker.closePopup();
            }

            loadPollingScheme(record);
        }
    };
})();
</script>