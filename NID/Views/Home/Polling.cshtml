    async function loadPollingScheme(record) {
        if (!record) {
            showToast(
                "The selected polling station could not be identified.",
                "error"
            );

            return;
        }

        if (
            record.Sr === null ||
            record.Sr === undefined ||
            record.Sr === ""
        ) {
            showToast(
                "This polling station does not have a serial number.",
                "error"
            );

            return;
        }

        state.selectedRecord = record;

        var currentRequest = ++state.schemeRequestNumber;
        var filters = getSelectedFilters();
        var requestUrl = buildPollingSchemeUrl(
            filters,
            record.Sr
        );

        openSchemeSection(record);
        setSchemeLoading(true);

        try {
            var response = await fetch(requestUrl, {
                method: "GET",
                credentials: "same-origin",
                headers: {
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (!response.ok) {
                throw new Error(
                    "The server returned HTTP " +
                    response.status +
                    " " +
                    response.statusText
                );
            }

            var result = await response.json();

            if (currentRequest !== state.schemeRequestNumber) {
                return;
            }

            var schemeRows = extractDataArray(result)
                .map(normalizeSchemeRecord);

            state.schemeData = schemeRows;

            if (!schemeRows.length) {
                showSchemeEmptyState(record);
                return;
            }

            renderPollingScheme(record, schemeRows);

            showToast(
                formatNumber(schemeRows.length) +
                " polling-scheme areas loaded.",
                "success"
            );
        }
        catch (error) {
            console.error(
                "Polling scheme loading failed:",
                error
            );

            showSchemeError(
                "The polling scheme could not be loaded. " +
                error.message
            );
        }
        finally {
            if (currentRequest === state.schemeRequestNumber) {
                setSchemeLoading(false);
            }
        }
    }
    function buildPollingSchemeUrl(filters, sr) {
        var query = [];

        if (filters.year) {
            query.push(
                "year=" +
                encodeURIComponent(filters.year)
            );
        }

        if (filters.election) {
            query.push(
                "election=" +
                encodeURIComponent(filters.election)
            );
        }

        if (filters.assembly) {
            query.push(
                "assembly=" +
                encodeURIComponent(filters.assembly)
            );
        }

        if (filters.seat) {
            query.push(
                "seat=" +
                encodeURIComponent(filters.seat)
            );
        }

        query.push(
            "sr=" +
            encodeURIComponent(sr)
        );

        query.push(
            "_=" +
            new Date().getTime()
        );

        return getPollingSchemeUrl +
            (getPollingSchemeUrl.indexOf("?") >= 0
                ? "&"
                : "?") +
            query.join("&");
    }
    function normalizeSchemeRecord(item, index) {
        item = item || {};

        return {
            __index: index,

            Seat: getProperty(item, "Seat"),

            Sr: toNullableNumber(
                getProperty(item, "Sr")
            ),

            Area: getProperty(item, "Area"),

            Bl: toNullableNumber(
                getProperty(item, "Bl")
            ),

            MVoter: toNumber(
                getProperty(item, "MVoter")
            ),

            FVoter: toNumber(
                getProperty(item, "FVoter")
            ),

            Voter: toNumber(
                getProperty(item, "Voter")
            )
        };
    }
    function openSchemeSection(record) {
        elements.pollingSchemeSection.style.display = "block";

        elements.schemeHeading.textContent =
            displayValue(
                record.PollingStation || record.Station,
                "Polling Station Profile"
            );

        elements.schemeSubtitle.textContent =
            joinNonEmpty(
                [
                    record.Seat,
                    record.Assembly,
                    record.District,
