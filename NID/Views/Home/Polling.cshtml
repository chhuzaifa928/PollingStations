<div id="loadingOverlay" class="ems-loading-overlay">
    <div class="ems-loader-card">
        <div class="ems-spinner"></div>
        <div class="ems-loader-title">Loading polling stations</div>
        <div class="ems-loader-text">
            Retrieving election, voter and geographic information…
        </div>
    </div>
</div>

<div id="emsToast" class="ems-toast"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        crossorigin=""></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(function () {
    "use strict";

    var getPollingStationsUrl = '@Html.Raw(HttpUtility.JavaScriptStringEncode(pollingStationsUrl))';
    var getPollingSchemeUrl = '@Html.Raw(HttpUtility.JavaScriptStringEncode(pollingSchemeUrl))';
    var state = {
        allData: [],
        visibleData: [],
        map: null,
        markerCluster: null,
        markerRecords: [],
        selectedRecord: null,
        requestNumber: 0,
        filtersInitialized: false,
        isFullscreen: false,
        initialBounds: null,

        schemeData: [],
        schemeRequestNumber: 0,
        schemeGenderChart: null,
        schemeAreaChart: null
    };

    var elements = {};

    document.addEventListener("DOMContentLoaded", function () {
        cacheElements();
        initializeMap();
        bindEvents();
        loadPollingStations(true);
    });

    function cacheElements() {
        elements.filterElection = document.getElementById("filterElection");
        elements.filterAssembly = document.getElementById("filterAssembly");
        elements.filterSeat = document.getElementById("filterSeat");
        elements.filterYear = document.getElementById("filterYear");

        elements.refreshDataButton = document.getElementById("refreshDataButton");
        elements.stationSearch = document.getElementById("stationSearch");
        elements.resetMapButton = document.getElementById("resetMapButton");
        elements.fullscreenMapButton = document.getElementById("fullscreenMapButton");

        elements.kpiStations = document.getElementById("kpiStations");
        elements.kpiVoters = document.getElementById("kpiVoters");
        elements.kpiMaleVoters = document.getElementById("kpiMaleVoters");
        elements.kpiFemaleVoters = document.getElementById("kpiFemaleVoters");

        elements.resultStatus = document.getElementById("resultStatus");
        elements.mapSummary = document.getElementById("mapSummary");
        elements.mapCard = document.getElementById("mapCard");

        elements.detailsTitle = document.getElementById("detailsTitle");
        elements.detailsLocation = document.getElementById("detailsLocation");
        elements.detailsBody = document.getElementById("detailsBody");

        elements.loadingOverlay = document.getElementById("loadingOverlay");
        elements.toast = document.getElementById("emsToast");

        elements.pollingSchemeSection =
            document.getElementById("pollingSchemeSection");

        elements.schemeHeading =
            document.getElementById("schemeHeading");

        elements.schemeSubtitle =
            document.getElementById("schemeSubtitle");

        elements.schemeRecordBadge =
            document.getElementById("schemeRecordBadge");

        elements.schemeLoadingState =
            document.getElementById("schemeLoadingState");

        elements.schemeErrorState =
            document.getElementById("schemeErrorState");

        elements.schemeContent =
            document.getElementById("schemeContent");

        elements.schemeEmptyState =
            document.getElementById("schemeEmptyState");

        elements.schemeAreaCount =
            document.getElementById("schemeAreaCount");

        elements.schemeTotalVoters =
            document.getElementById("schemeTotalVoters");

        elements.schemeMaleVoters =
            document.getElementById("schemeMaleVoters");

        elements.schemeFemaleVoters =
            document.getElementById("schemeFemaleVoters");

        elements.schemeGenderRatio =
            document.getElementById("schemeGenderRatio");

        elements.schemeTableBody =
            document.getElementById("schemeTableBody");

        elements.schemeAreaSearch =
            document.getElementById("schemeAreaSearch");

        elements.closeSchemeButton =
            document.getElementById("closeSchemeButton");
    }

    function bindEvents() {
        elements.filterElection.addEventListener("change", function () {
            loadPollingStations(false);
        });

        elements.filterAssembly.addEventListener("change", function () {
            loadPollingStations(false);
        });

        elements.filterSeat.addEventListener("change", function () {
            loadPollingStations(false);
        });

        elements.filterYear.addEventListener("change", function () {
            loadPollingStations(false);
        });

        elements.refreshDataButton.addEventListener("click", function () {
            loadPollingStations(false);
        });

        elements.stationSearch.addEventListener(
            "input",
            debounce(function () {
                applyClientSearch();
            }, 250)
        );

        elements.resetMapButton.addEventListener("click", function () {
            fitMapToVisibleMarkers();
        });

        elements.fullscreenMapButton.addEventListener("click", function () {
            toggleFullscreenMap();
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && state.isFullscreen) {
                toggleFullscreenMap(false);
            }
        });

        elements.closeSchemeButton.addEventListener(
            "click",
            function () {
                closePollingScheme();
            }
        );

        elements.schemeAreaSearch.addEventListener(
            "input",
            debounce(function () {
                filterPollingSchemeTable();
            }, 200)
        );
    }

    function initializeMap() {
        state.map = L.map("pollingStationsMap", {
            zoomControl: true,
            preferCanvas: true,
            minZoom: 3,
            maxZoom: 19
        }).setView([30.3753, 69.3451], 5);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributors'
            }
        ).addTo(state.map);

        state.markerCluster = L.markerClusterGroup({
            showCoverageOnHover: false,
            spiderfyOnMaxZoom: true,
            removeOutsideVisibleBounds: true,
            animate: true,
            chunkedLoading: true,
            chunkInterval: 100,
            chunkDelay: 20,
            maxClusterRadius: 55
        });

        state.map.addLayer(state.markerCluster);
        addMapLegend();

        setTimeout(function () {
            state.map.invalidateSize();
        }, 200);
    }

    function addMapLegend() {
        var legend = L.control({ position: "bottomright" });

        legend.onAdd = function () {
            var div = L.DomUtil.create("div", "ems-map-legend");

            div.innerHTML =
                '<div class="ems-map-legend-title">Station Category</div>' +
                legendItem("#2670c8", "Male") +
                legendItem("#c14f87", "Female") +
                legendItem("#7357a8", "Combined") +
                legendItem("#176b87", "Other / Unspecified") +
                '<div style="margin-top:7px;color:#7c8798;">' +
                    '<span style="color:#f1a521;font-weight:900;">●</span> ' +
                    'Estimated or non-point geometry' +
                '</div>';

            L.DomEvent.disableClickPropagation(div);
            return div;
        };

        legend.addTo(state.map);
    }

    function legendItem(color, text) {
        return '<div class="ems-legend-item">' +
            '<span class="ems-legend-dot" style="background:' + color + ';"></span>' +
            '<span>' + escapeHtml(text) + '</span>' +
        '</div>';
    }

    async function loadPollingStations(initialLoad) {
        var currentRequest = ++state.requestNumber;
        var filters = getSelectedFilters();
        var url = buildRequestUrl(filters);

        setLoading(true);
        setFilterControlsDisabled(true);

        try {
            var response = await fetch(url, {
                method: "GET",
                credentials: "same-origin",
                headers: {
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (!response.ok) {
                throw new Error(
                    "The server returned HTTP " +
                    response.status +
                    " " +
                    response.statusText
                );
            }

            var responseObject = await response.json();

            if (currentRequest !== state.requestNumber) {
                return;
            }

            var records = extractDataArray(responseObject)
                .map(normalizeRecord);

            state.allData = records;

            populateFilterOptions(records, filters, initialLoad);

            state.visibleData = records;
            elements.stationSearch.value = "";

            updateDashboard(records);
            renderMarkers(records);
            clearSelectedStation();

            state.filtersInitialized = true;

            showToast(
                formatNumber(records.length) +
                " polling-station records loaded.",
                "success"
            );
        }
        catch (error) {
            console.error("Polling station loading failed:", error);

            state.allData = [];
            state.visibleData = [];

            updateDashboard([]);
            renderMarkers([]);
            clearSelectedStation();

            elements.resultStatus.textContent = "Unable to load election data";

            showToast(
                "Polling-station data could not be loaded. " + error.message,
                "error"
            );
        }
        finally {
            if (currentRequest === state.requestNumber) {
                setLoading(false);
                setFilterControlsDisabled(false);
            }
        }
    }

    function buildRequestUrl(filters) {
        var query = [];

        if (filters.year) {
            query.push("year=" + encodeURIComponent(filters.year));
        }

        if (filters.election) {
            query.push("election=" + encodeURIComponent(filters.election));
        }

        if (filters.assembly) {
            query.push("assembly=" + encodeURIComponent(filters.assembly));
        }

        if (filters.seat) {
            query.push("seat=" + encodeURIComponent(filters.seat));
        }

        query.push("_=" + new Date().getTime());

        return getPollingStationsUrl +
            (getPollingStationsUrl.indexOf("?") >= 0 ? "&" : "?") +
            query.join("&");
    }

    function getSelectedFilters() {
        return {
            election: elements.filterElection.value || "",
            assembly: elements.filterAssembly.value || "",
            seat: elements.filterSeat.value || "",
            year: elements.filterYear.value || ""
        };
    }

    function extractDataArray(responseObject) {
        if (Array.isArray(responseObject)) {
            return responseObject;
        }

        if (responseObject && Array.isArray(responseObject.data)) {
            return responseObject.data;
        }

        if (responseObject && Array.isArray(responseObject.Data)) {
            return responseObject.Data;
        }

        return [];
    }

    function normalizeRecord(item, index) {
        item = item || {};

        return {
            __index: index,

            Election: getProperty(item, "Election"),
            Year: toNullableNumber(getProperty(item, "Year")),
            Assembly: getProperty(item, "Assembly"),
            Seat: getProperty(item, "Seat"),
            Tehsil: getProperty(item, "Tehsil"),
            Sr: toNullableNumber(getProperty(item, "Sr")),
            SType: getProperty(item, "SType"),
            Station: getProperty(item, "Station"),

            MVoter: toNumber(getProperty(item, "MVoter")),
            FVoter: toNumber(getProperty(item, "FVoter")),
            Voter: toNumber(getProperty(item, "Voter")),

            MBooth: toNumber(getProperty(item, "MBooth")),
            FBooth: toNumber(getProperty(item, "FBooth")),
            Booth: toNumber(getProperty(item, "Booth")),

            PollingStation: getProperty(item, "PollingStation"),
            Category: getProperty(item, "Category"),
            District: getProperty(item, "District"),
            Source: getProperty(item, "Source"),
            MatchedPlace: getProperty(item, "MatchedPlace"),
            GeometryType: getProperty(item, "GeometryType"),

            Latitude: toNullableNumber(getProperty(item, "Latitude")),
            Longitude: toNullableNumber(getProperty(item, "Longitude")),
            OffsetMeters: toNullableNumber(getProperty(item, "OffsetMeters")),
            Precision: getProperty(item, "Precision")
        };
    }

    function getProperty(object, propertyName) {
        if (Object.prototype.hasOwnProperty.call(object, propertyName)) {
            return object[propertyName];
        }

        var camelName =
            propertyName.charAt(0).toLowerCase() +
            propertyName.substring(1);

        if (Object.prototype.hasOwnProperty.call(object, camelName)) {
            return object[camelName];
        }

        return null;
    }

    function populateFilterOptions(records, selectedFilters, initialLoad) {
        var elections = uniqueSorted(
            records.map(function (x) { return x.Election; })
        );

        var assemblies = uniqueSorted(
            records.map(function (x) { return x.Assembly; })
        );

        var seats = uniqueSorted(
            records.map(function (x) { return x.Seat; }),
            naturalSort
        );

        var years = uniqueSorted(
            records.map(function (x) { return x.Year; }),
            function (a, b) {
                return Number(b) - Number(a);
            }
        );

        populateSelect(
            elements.filterElection,
            elections,
            "All Elections",
            selectedFilters.election
        );

        populateSelect(
            elements.filterAssembly,
            assemblies,
            "All Assemblies",
            selectedFilters.assembly
        );

        populateSelect(
            elements.filterSeat,
            seats,
            "All Seats",
            selectedFilters.seat
        );

        var preferredYear = selectedFilters.year;

        if (initialLoad && !preferredYear) {
            var currentYear = String(new Date().getFullYear());

            if (years.map(String).indexOf(currentYear) >= 0) {
                preferredYear = currentYear;
            }
        }

        populateSelect(
            elements.filterYear,
            years,
            "All Years",
            preferredYear
        );
    }

    function populateSelect(selectElement, values, emptyText, selectedValue) {
        var selectedText = selectedValue == null
            ? ""
            : String(selectedValue);

        var html =
            '<option value="">' +
            escapeHtml(emptyText) +
            '</option>';

        values.forEach(function (value) {
            var stringValue = String(value);
            var selected = stringValue === selectedText
                ? " selected"
                : "";

            html +=
                '<option value="' +
                escapeAttribute(stringValue) +
                '"' +
                selected +
                '>' +
                escapeHtml(stringValue) +
                '</option>';
        });

        selectElement.innerHTML = html;

        if (
            selectedText &&
            !Array.from(selectElement.options).some(function (option) {
                return option.value === selectedText;
            })
        ) {
            var retainedOption = document.createElement("option");
            retainedOption.value = selectedText;
            retainedOption.textContent = selectedText;
            retainedOption.selected = true;
            selectElement.appendChild(retainedOption);
        }
    }

    function uniqueSorted(values, sortFunction) {
        var valueMap = {};

        values.forEach(function (value) {
            if (
                value !== null &&
                value !== undefined &&
                String(value).trim() !== ""
            ) {
                valueMap[String(value).trim()] = value;
            }
        });

        var result = Object.keys(valueMap).map(function (key) {
            return valueMap[key];
        });

        return result.sort(sortFunction || naturalSort);
    }

    function naturalSort(a, b) {
        return String(a).localeCompare(
            String(b),
            undefined,
            {
                numeric: true,
                sensitivity: "base"
            }
        );
    }

    function updateDashboard(records) {
        var totals = records.reduce(function (result, record) {
            result.voters += record.Voter;
            result.male += record.MVoter;
            result.female += record.FVoter;
            return result;
        }, {
            voters: 0,
            male: 0,
            female: 0
        });

        /*
           Some sources may leave Voter blank while male/female values exist.
           In that situation, use male + female for the overall total.
        */
        if (totals.voters === 0 && (totals.male > 0 || totals.female > 0)) {
            totals.voters = totals.male + totals.female;
        }

        animateNumber(elements.kpiStations, records.length);
        animateNumber(elements.kpiVoters, totals.voters);
        animateNumber(elements.kpiMaleVoters, totals.male);
        animateNumber(elements.kpiFemaleVoters, totals.female);

        var validCoordinates = records.filter(hasValidCoordinates).length;
        var invalidCoordinates = records.length - validCoordinates;

        elements.resultStatus.textContent =
            formatNumber(records.length) +
            " records • " +
            formatNumber(validCoordinates) +
            " mapped";

        elements.mapSummary.textContent =
            formatNumber(validCoordinates) +
            " mapped stations" +
            (invalidCoordinates > 0
                ? " • " +
                  formatNumber(invalidCoordinates) +
                  " without valid coordinates"
                : "");
    }

    function renderMarkers(records) {
        state.markerCluster.clearLayers();
        state.markerRecords = [];
        state.initialBounds = null;

        var validRecords = records.filter(hasValidCoordinates);
        var bounds = [];

        validRecords.forEach(function (record) {
            var marker = createMarker(record);

            state.markerCluster.addLayer(marker);
            state.markerRecords.push({
                record: record,
                marker: marker
            });

            bounds.push([record.Latitude, record.Longitude]);
        });

        if (bounds.length > 0) {
            state.initialBounds = L.latLngBounds(bounds);

            state.map.fitBounds(state.initialBounds, {
                padding: [35, 35],
                maxZoom: 14
            });
        }
        else {
            state.map.setView([30.3753, 69.3451], 5);
        }

        setTimeout(function () {
            state.map.invalidateSize();
        }, 100);
    }

    function createMarker(record) {
        var marker = L.marker(
            [record.Latitude, record.Longitude],
            {
                icon: createStationIcon(record),
                title: displayValue(
                    record.PollingStation || record.Station,
                    "Polling station"
                ),
                riseOnHover: true,
                keyboard: true
            }
        );

        marker.bindPopup(buildPopupHtml(record), {
            maxWidth: 350,
            minWidth: 290,
            autoPanPadding: [30, 30]
        });

        marker.on("click", function () {
            showStationDetails(record);
        });

        marker.on("popupopen", function () {
            showStationDetails(record);
        });

        return marker;
    }

    function createStationIcon(record) {
        var categoryClass = getCategoryClass(record.Category);
        var estimatedClass = isEstimatedGeometry(record)
            ? " ems-marker-estimated"
            : "";

        var symbol = getMarkerSymbol(record);

        return L.divIcon({
            className: "ems-marker-container",
            html:
                '<div class="ems-map-marker ' +
                categoryClass +
                estimatedClass +
                '">' +
                    '<span>' + escapeHtml(symbol) + '</span>' +
                '</div>',
            iconSize: [38, 42],
            iconAnchor: [19, 40],
            popupAnchor: [0, -36]
        });
    }

    function getCategoryClass(category) {
        var text = String(category || "").toLowerCase();

        if (text.indexOf("combined") >= 0 ||
            text.indexOf("mix") >= 0 ||
            text.indexOf("both") >= 0) {
            return "ems-marker-combined";
        }

        if (text.indexOf("female") >= 0 ||
            text.indexOf("women") >= 0) {
            return "ems-marker-female";
        }

        if (text.indexOf("male") >= 0 ||
            text.indexOf("men") >= 0) {
            return "ems-marker-male";
        }

        return "ems-marker-other";
    }

    function getMarkerSymbol(record) {
        var geometry = String(record.GeometryType || "").toLowerCase();

        if (geometry.indexOf("polygon") >= 0) {
            return "◆";
        }

        if (geometry.indexOf("line") >= 0) {
            return "━";
        }

        var category = String(record.Category || "").toLowerCase();

        if (category.indexOf("female") >= 0) {
            return "F";
        }

        if (category.indexOf("male") >= 0 &&
            category.indexOf("female") < 0) {
            return "M";
        }

        if (
            category.indexOf("combined") >= 0 ||
            category.indexOf("both") >= 0 ||
            category.indexOf("mix") >= 0
        ) {
            return "C";
        }

        return "●";
    }

    function isEstimatedGeometry(record) {
        var geometry = String(record.GeometryType || "").toLowerCase();
        var precision = String(record.Precision || "").toLowerCase();

        return (
            geometry &&
            geometry !== "point" &&
            geometry !== "multipoint"
        ) ||
        precision.indexOf("estimate") >= 0 ||
        precision.indexOf("approx") >= 0 ||
        (record.OffsetMeters !== null && record.OffsetMeters > 100);
    }

