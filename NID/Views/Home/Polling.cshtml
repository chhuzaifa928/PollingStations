    function animateNumber(element, targetValue) {
        var target = Math.max(0, toNumber(targetValue));
        var duration = 550;
        var startTime = null;
        var initialValue = toNumber(
            String(element.textContent || "0").replace(/,/g, "")
        );

        function step(timestamp) {
            if (!startTime) {
                startTime = timestamp;
            }

            var progress = Math.min(
                (timestamp - startTime) / duration,
                1
            );

            var easedProgress = 1 - Math.pow(1 - progress, 3);
            var current =
                initialValue +
                ((target - initialValue) * easedProgress);

            element.textContent = formatNumber(Math.round(current));

            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        }

        window.requestAnimationFrame(step);
    }

    function hasValidCoordinates(record) {
        return (
            record.Latitude !== null &&
            record.Longitude !== null &&
            isFinite(record.Latitude) &&
            isFinite(record.Longitude) &&
            record.Latitude >= -90 &&
            record.Latitude <= 90 &&
            record.Longitude >= -180 &&
            record.Longitude <= 180 &&
            !(record.Latitude === 0 && record.Longitude === 0)
        );
    }

    function toNumber(value) {
        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return 0;
        }

        var parsed = Number(
            String(value).replace(/,/g, "")
        );

        return isFinite(parsed) ? parsed : 0;
    }

    function toNullableNumber(value) {
        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return null;
        }

        var parsed = Number(
            String(value).replace(/,/g, "")
        );

        return isFinite(parsed) ? parsed : null;
    }

    function formatNumber(value) {
        var number = toNumber(value);

        return number.toLocaleString("en-US", {
            maximumFractionDigits: 0
        });
    }

    function coordinateValue(value) {
        if (value === null || !isFinite(value)) {
            return "Not available";
        }

        return Number(value).toFixed(6);
    }

    function offsetValue(value) {
        if (value === null || !isFinite(value)) {
            return "Not available";
        }

        return Number(value).toLocaleString("en-US", {
            maximumFractionDigits: 1
        }) + " metres";
    }

    function displayValue(value, fallback) {
        if (
            value === null ||
            value === undefined ||
            String(value).trim() === ""
        ) {
            return fallback || "Not available";
        }

        return String(value);
    }

    function joinNonEmpty(values, separator) {
        return values
            .filter(function (value) {
                return value !== null &&
                    value !== undefined &&
                    String(value).trim() !== "";
            })
            .join(separator);
    }

    function escapeHtml(value) {
        return String(value == null ? "" : value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function escapeAttribute(value) {
        return escapeHtml(value)
            .replace(/`/g, "&#096;");
    }

    function debounce(func, delay) {
        var timer;

        return function () {
            var context = this;
            var args = arguments;

            window.clearTimeout(timer);

            timer = window.setTimeout(function () {
                func.apply(context, args);
            }, delay);
        };
    }

