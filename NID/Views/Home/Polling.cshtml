
@{
    ViewBag.Title = "Election Polling Station Command Centre";
    Layout = "~/Views/Shared/_EconomicUnits.cshtml";

    var controllerName =
        ViewContext.RouteData.Values["controller"].ToString();

    var pollingStationsUrl = Url.Action(
        "GetPollingStations",
        controllerName
    );

    var pollingSchemeUrl = Url.Action(
        "GetPollingScheme",
        controllerName
    );
}
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      crossorigin="" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.css" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.Default.css" />

<style>
    .page-title-header{
        display:none;
    }
    :root {
        --ems-primary: #123c69;
        --ems-primary-dark: #0a2747;
        --ems-secondary: #176b87;
        --ems-accent: #18a999;
        --ems-success: #138a58;
        --ems-warning: #d88b16;
        --ems-danger: #c43c4e;
        --ems-purple: #7357a8;
        --ems-text: #172133;
        --ems-muted: #6f7c91;
        --ems-border: #dfe5ee;
        --ems-page: #f3f6fa;
        --ems-card: #ffffff;
        --ems-shadow: 0 14px 35px rgba(27, 44, 75, .10);
        --ems-soft-shadow: 0 7px 22px rgba(27, 44, 75, .08);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--ems-page);
    }

    .ems-page {
        min-height: calc(100vh - 65px);
        color: var(--ems-text);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .ems-hero {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        padding: 26px 30px;
        margin-bottom: 20px;
        color: #fff;
        background: radial-gradient(circle at 90% 10%, rgba(255,255,255,.18), transparent 25%), radial-gradient(circle at 75% 100%, rgba(24,169,153,.35), transparent 35%), linear-gradient(125deg, #092744 0%, #123c69 55%, #176b87 100%);
        box-shadow: var(--ems-shadow);
    }

        .ems-hero::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -80px;
            top: -95px;
            border-radius: 50%;
            border: 35px solid rgba(255,255,255,.07);
        }

    .ems-hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .ems-hero-title {
        margin: 0;
        font-size: 28px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .ems-hero-subtitle {
        max-width: 760px;
        margin: 8px 0 0;
        color: rgba(255,255,255,.82);
        font-size: 14px;
        line-height: 1.65;
    }

    .ems-live-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex: 0 0 auto;
        padding: 10px 14px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 999px;
        background: rgba(255,255,255,.10);
        backdrop-filter: blur(8px);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .ems-live-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #51e6a8;
        box-shadow: 0 0 0 6px rgba(81,230,168,.14);
        animation: emsPulse 1.8s infinite;
    }

    @@keyframes emsPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(.75);
            opacity: .65;
        }
    }

    .ems-filter-panel {
        background: var(--ems-card);
        border: 1px solid rgba(18,60,105,.07);
        border-radius: 18px;
        padding: 18px;
        margin-bottom: 18px;
        box-shadow: var(--ems-soft-shadow);
    }

    .ems-panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 15px;
    }

    .ems-panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 15px;
        font-weight: 800;
        color: var(--ems-primary-dark);
    }

    .ems-heading-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        color: #fff;
        background: linear-gradient(135deg, var(--ems-primary), var(--ems-secondary));
    }

    .ems-result-status {
        font-size: 12px;
        color: var(--ems-muted);
    }

    .ems-filter-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(150px, 1fr)) 150px;
        gap: 14px;
        align-items: end;
    }

    .ems-form-group {
        min-width: 0;
    }

    .ems-label {
        display: block;
        margin-bottom: 7px;
        color: #40506a;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .65px;
        text-transform: uppercase;
    }

    .ems-select,
    .ems-search-input {
        width: 100%;
        height: 45px;
        padding: 0 38px 0 13px;
        border: 1px solid var(--ems-border);
        border-radius: 11px;
        outline: none;
        color: var(--ems-text);
        background-color: #fbfcfe;
        font-size: 13px;
        font-weight: 600;
        transition: .2s ease;
    }

    .ems-select {
        cursor: pointer;
    }

        .ems-select:focus,
        .ems-search-input:focus {
            border-color: var(--ems-secondary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(23,107,135,.10);
        }

        .ems-select:disabled {
            cursor: not-allowed;
            opacity: .65;
            background: #f0f3f7;
        }

    .ems-refresh-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 45px;
        border: 0;
        border-radius: 11px;
        color: #fff;
        background: linear-gradient(135deg, var(--ems-primary), var(--ems-secondary));
        box-shadow: 0 8px 18px rgba(18,60,105,.20);
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

        .ems-refresh-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(18,60,105,.27);
        }

        .ems-refresh-button:disabled {
            cursor: wait;
            opacity: .65;
            transform: none;
        }

    .ems-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }

    .ems-kpi-card {
        position: relative;
        overflow: hidden;
        min-height: 142px;
        padding: 20px;
        border: 1px solid rgba(18,60,105,.06);
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--ems-soft-shadow);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .ems-kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--ems-shadow);
        }

        .ems-kpi-card::after {
            content: "";
            position: absolute;
            width: 115px;
            height: 115px;
            top: -42px;
            right: -34px;
            border-radius: 50%;
            background: var(--kpi-soft);
        }

    .ems-kpi-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ems-kpi-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        color: var(--kpi-color);
        background: var(--kpi-soft);
    }

    .ems-kpi-number {
        position: relative;
        z-index: 2;
        margin-top: 17px;
        color: var(--ems-text);
        font-size: 29px;
        line-height: 1;
        font-weight: 850;
        letter-spacing: -.5px;
    }

    .ems-kpi-label {
        position: relative;
        z-index: 2;
        margin-top: 8px;
        color: var(--ems-muted);
        font-size: 12px;
        font-weight: 700;
    }

    .ems-kpi-stations {
        --kpi-color: #176b87;
        --kpi-soft: rgba(23,107,135,.11);
    }

    .ems-kpi-voters {
        --kpi-color: #7357a8;
        --kpi-soft: rgba(115,87,168,.11);
    }

    .ems-kpi-male {
        --kpi-color: #2670c8;
        --kpi-soft: rgba(38,112,200,.11);
    }

    .ems-kpi-female {
        --kpi-color: #c14f87;
        --kpi-soft: rgba(193,79,135,.11);
    }

    .ems-workspace {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 385px;
        gap: 18px;
        align-items: stretch;
    }

    .ems-map-card,
    .ems-details-card {
        overflow: hidden;
        border: 1px solid rgba(18,60,105,.07);
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--ems-shadow);
    }

    .ems-map-card {
        min-width: 0;
    }

    .ems-map-toolbar {
        min-height: 67px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border-bottom: 1px solid var(--ems-border);
        background: #fff;
    }

    .ems-map-heading {
        min-width: 180px;
    }

    .ems-map-title {
        margin: 0;
        color: var(--ems-primary-dark);
        font-size: 15px;
        font-weight: 850;
    }

    .ems-map-subtitle {
        margin-top: 4px;
        color: var(--ems-muted);
        font-size: 11px;
    }

    .ems-map-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .ems-search-wrap {
        position: relative;
        width: min(290px, 36vw);
    }

    .ems-search-input {
        height: 40px;
        padding-left: 38px;
        padding-right: 12px;
        font-weight: 500;
    }

    .ems-search-icon {
        position: absolute;
        top: 50%;
        left: 13px;
        transform: translateY(-50%);
        color: #8793a6;
        pointer-events: none;
    }

    .ems-map-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border: 1px solid var(--ems-border);
        border-radius: 10px;
        color: var(--ems-primary);
        background: #fff;
        cursor: pointer;
        transition: .2s ease;
    }

        .ems-map-button:hover {
            color: #fff;
            border-color: var(--ems-primary);
            background: var(--ems-primary);
        }

    #pollingStationsMap {
        width: 100%;
        height: 680px;
        background: #e9eef4;
    }

    .ems-details-card {
        height: 748px;
        display: flex;
        flex-direction: column;
    }

    .ems-details-header {
        flex: 0 0 auto;
        padding: 18px 19px;
        color: #fff;
        background: linear-gradient(135deg, rgba(9,39,68,.97), rgba(23,107,135,.94)), var(--ems-primary);
    }

    .ems-details-eyebrow {
        margin-bottom: 7px;
        color: rgba(255,255,255,.70);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .ems-details-title {
        margin: 0;
        font-size: 18px;
        line-height: 1.35;
        font-weight: 850;
    }

    .ems-details-location {
        display: flex;
        gap: 7px;
        align-items: flex-start;
        margin-top: 9px;
        color: rgba(255,255,255,.78);
        font-size: 12px;
        line-height: 1.5;
    }

    .ems-details-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 17px;
        background: #f8fafc;
    }

    .ems-empty-selection {
        height: 100%;
        min-height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 30px;
        text-align: center;
        color: var(--ems-muted);
    }

    .ems-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 82px;
        height: 82px;
        margin-bottom: 18px;
        border-radius: 50%;
        color: var(--ems-secondary);
        background: rgba(23,107,135,.10);
    }

    .ems-empty-title {
        margin: 0 0 7px;
        color: var(--ems-primary-dark);
        font-size: 16px;
        font-weight: 850;
    }

    .ems-empty-text {
        max-width: 280px;
        margin: 0;
        font-size: 12px;
        line-height: 1.65;
    }

    .ems-breakdown-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-bottom: 13px;
    }

    .ems-breakdown-card {
        padding: 13px;
        border: 1px solid var(--ems-border);
        border-radius: 13px;
        background: #fff;
    }

    .ems-breakdown-value {
        color: var(--ems-primary-dark);
        font-size: 19px;
        font-weight: 850;
    }

    .ems-breakdown-label {
        margin-top: 4px;
        color: var(--ems-muted);
        font-size: 10px;
        font-weight: 750;
        letter-spacing: .45px;
        text-transform: uppercase;
    }

    .ems-section-card {
        margin-bottom: 12px;
        padding: 15px;
        border: 1px solid var(--ems-border);
        border-radius: 14px;
        background: #fff;
    }

        .ems-section-card:last-child {
            margin-bottom: 0;
        }

    .ems-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 12px;
        color: var(--ems-primary-dark);
        font-size: 12px;
        font-weight: 850;
        letter-spacing: .25px;
        text-transform: uppercase;
    }

    .ems-info-list {
        display: grid;
        gap: 9px;
    }

    .ems-info-row {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 10px;
        align-items: start;
        padding-bottom: 9px;
        border-bottom: 1px dashed #e5e9ef;
    }

        .ems-info-row:last-child {
            padding-bottom: 0;
            border-bottom: 0;
        }

    .ems-info-label {
        color: var(--ems-muted);
        font-size: 10px;
        font-weight: 750;
        letter-spacing: .25px;
        text-transform: uppercase;
    }

    .ems-info-value {
        overflow-wrap: anywhere;
        color: #25344b;
        font-size: 12px;
        line-height: 1.45;
        font-weight: 650;
        text-align: right;
    }

    .ems-tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 12px;
    }

    .ems-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        color: var(--ems-primary);
        background: rgba(18,60,105,.08);
        font-size: 10px;
        line-height: 1;
        font-weight: 800;
    }

    .ems-coordinate-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        height: 40px;
        margin-top: 12px;
        border: 1px solid rgba(23,107,135,.22);
        border-radius: 10px;
        color: var(--ems-secondary);
        background: rgba(23,107,135,.06);
        font-size: 11px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s ease;
    }

        .ems-coordinate-button:hover {
            color: #fff;
            background: var(--ems-secondary);
            text-decoration: none;
        }

    .ems-map-legend {
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 5px 18px rgba(18,60,105,.18);
        color: var(--ems-text);
        font-size: 10px;
        line-height: 1.4;
    }

    .ems-map-legend-title {
        margin-bottom: 7px;
        color: var(--ems-primary-dark);
        font-weight: 850;
        text-transform: uppercase;
    }

    .ems-legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 5px 0;
    }

    .ems-legend-dot {
        width: 10px;
        height: 10px;
        border: 2px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 1px rgba(0,0,0,.15);
    }

    .ems-marker-container {
        background: transparent;
        border: 0;
    }

    .ems-map-marker {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: 3px solid #fff;
        border-radius: 50% 50% 50% 8px;
        box-shadow: 0 4px 12px rgba(0,0,0,.32);
        transform: rotate(-45deg);
    }

        .ems-map-marker span {
            display: flex;
            align-items: center;
            justify-content: center;
            transform: rotate(45deg);
            color: #fff;
            font-size: 14px;
            font-weight: 900;
        }

    .ems-marker-male {
        background: #2670c8;
    }

    .ems-marker-female {
        background: #c14f87;
    }

    .ems-marker-combined {
        background: #7357a8;
    }

    .ems-marker-other {
        background: #176b87;
    }

    .ems-marker-estimated::after {
        content: "";
        position: absolute;
        width: 9px;
        height: 9px;
        right: -2px;
        top: -2px;
        border: 2px solid #fff;
        border-radius: 50%;
        background: #f1a521;
    }

    .ems-popup {
        min-width: 285px;
        max-width: 330px;
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .ems-popup-header {
        margin: -14px -20px 13px;
        padding: 14px 16px;
        border-radius: 12px 12px 0 0;
        color: #fff;
        background: linear-gradient(135deg, var(--ems-primary-dark), var(--ems-secondary));
    }

    .ems-popup-title {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        font-weight: 850;
    }

    .ems-popup-subtitle {
        margin-top: 5px;
        color: rgba(255,255,255,.75);
        font-size: 10px;
    }

    .ems-popup-kpis {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 7px;
        margin-bottom: 11px;
    }

    .ems-popup-kpi {
        padding: 9px 6px;
        border-radius: 9px;
        background: #f3f6fa;
        text-align: center;
    }

        .ems-popup-kpi strong {
            display: block;
            color: var(--ems-primary-dark);
            font-size: 14px;
        }

        .ems-popup-kpi span {
            color: var(--ems-muted);
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }

    .ems-popup-meta {
        display: grid;
        gap: 6px;
        font-size: 10px;
    }

    .ems-popup-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding-bottom: 5px;
        border-bottom: 1px dashed #e2e6ec;
    }

        .ems-popup-row span:first-child {
            color: var(--ems-muted);
        }

        .ems-popup-row span:last-child {
            color: #29374c;
            font-weight: 750;
            text-align: right;
        }

    .ems-popup-button {
        display: block;
        width: 100%;
        margin-top: 11px;
        padding: 9px;
        border: 0;
        border-radius: 9px;
        color: #fff;
        background: var(--ems-primary);
        font-size: 10px;
        font-weight: 850;
        cursor: pointer;
    }

    .leaflet-popup-content-wrapper {
        border-radius: 13px;
        box-shadow: 0 12px 30px rgba(10,39,71,.22);
    }

    .leaflet-popup-content {
        margin: 14px 20px 16px;
    }

    .marker-cluster-small,
    .marker-cluster-medium,
    .marker-cluster-large {
        background: rgba(18,60,105,.22);
    }

        .marker-cluster-small div,
        .marker-cluster-medium div,
        .marker-cluster-large div {
            color: #fff;
            background: var(--ems-primary);
            font-weight: 850;
        }

    .ems-loading-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 25px;
        background: rgba(9,28,49,.47);
        backdrop-filter: blur(3px);
    }

        .ems-loading-overlay.is-visible {
            display: flex;
        }

    .ems-loader-card {
        min-width: 275px;
        padding: 25px;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 18px 50px rgba(0,0,0,.20);
        text-align: center;
    }

    .ems-spinner {
        width: 46px;
        height: 46px;
        margin: 0 auto 15px;
        border: 4px solid #dce7ef;
        border-top-color: var(--ems-secondary);
        border-radius: 50%;
        animation: emsSpin .8s linear infinite;
    }

    @@keyframes emsSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .ems-loader-title {
        color: var(--ems-primary-dark);
        font-size: 14px;
        font-weight: 850;
    }

    .ems-loader-text {
        margin-top: 6px;
        color: var(--ems-muted);
        font-size: 11px;
    }

    .ems-toast {
        position: fixed;
        z-index: 999999;
        right: 22px;
        bottom: 22px;
        max-width: 380px;
        padding: 14px 16px;
        border-radius: 12px;
        color: #fff;
        background: #24344a;
        box-shadow: 0 12px 30px rgba(0,0,0,.20);
        font-size: 12px;
        line-height: 1.5;
        opacity: 0;
        visibility: hidden;
        transform: translateY(14px);
        transition: .25s ease;
    }

        .ems-toast.is-visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .ems-toast.is-error {
            background: var(--ems-danger);
        }

