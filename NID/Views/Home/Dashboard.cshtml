
@{
    ViewBag.Title = "Election Day Dashboard";
}

<div class="container-fluid">

    <div class="row">

        <div class="col-lg-3">
            <div class="small-box bg-primary">
                <div class="inner">
                    <h2>55</h2>
                    <p>Total Vehicles</p>
                </div>
                <i class="fas fa-bus fa-3x"></i>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="small-box bg-success">
                <div class="inner">
                    <h2>13</h2>
                    <p>Active Vehicles</p>
                </div>
                <i class="fas fa-map-marker-alt fa-3x"></i>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h2>9</h2>
                    <p>Election Incidents</p>
                </div>
                <i class="fas fa-exclamation-triangle fa-3x"></i>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h2>47</h2>
                    <p>Completed Trips</p>
                </div>
                <i class="fas fa-route fa-3x"></i>
            </div>
        </div>

    </div>
    <div class="card card-primary">

        <div class="card-header">
            <h3 class="card-title">Active Election Transport</h3>
        </div>

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead>

                    <tr>

                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Route</th>
                        <th>Polling Station</th>
                        <th>Passengers</th>
                        <th>Trips</th>
                        <th>Status</th>
                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var v in Model.Vehicles)
                    {

                        <tr>

                            <td>@v.VehicleNo</td>

                            <td>@v.DriverName</td>

                            <td>@v.RouteName</td>

                            <td>@v.PollingStation</td>

                            <td>@v.Passengers</td>

                            <td>@v.TotalTrips</td>

                            <td>

                                @if (v.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Returning</span>
                                }

                            </td>

                            <td>

                                <a class="btn btn-primary btn-sm">

                                    <i class="fas fa-map"></i>

                                    Track

                                </a>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>
    <div class="card card-danger">

        <div class="card-header">

            Election Incident Reporting

        </div>

        <div class="card-body">

            <form>

                <div class="row">

                    <div class="col-md-3">

                        <label>Polling Station</label>

                        <select class="form-control">

                            <option>PS-101</option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <label>Incident Type</label>

                        <select class="form-control">

                            <option>Violence</option>

                            <option>Transport Delay</option>

                            <option>Vehicle Breakdown</option>

                            <option>Missing Polling Staff</option>

                            <option>Medical Emergency</option>

                            <option>Security Threat</option>

                            <option>Power Failure</option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label>Severity</label>

                        <select class="form-control">

                            <option>Low</option>

                            <option>Medium</option>

                            <option>High</option>

                            <option>Critical</option>

                        </select>

                    </div>

                    <div class="col-md-4">

                        <label>Description</label>

<textarea class="form-control"></textarea>

                    </div>

                </div>

                <br>

                <button class="btn btn-danger">

                    Report Incident

                </button>

            </form>

        </div>

    </div>
    <table class="table table-bordered">

        <thead>

            <tr>

                <th>Station</th>

                <th>Expected</th>

                <th>Picked</th>

                <th>Waiting</th>

                <th>Status</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var p in Model.PollingStations)
            {

                <tr>

                    <td>@p.Code</td>

                    <td>@p.Expected</td>

                    <td>@p.Picked</td>

                    <td>@p.Waiting</td>

                    <td>

                        <div class="progress">

                            <div class="progress-bar bg-success"
                                 style="width:@p.Percent%">
                                @p.Percent%
                            </div>

                        </div>

                    </td>

                </tr>

            }

        </tbody>

    </table>
