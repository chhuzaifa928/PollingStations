                        </div>
                        <div class="collapse navbar-collapse" id="myNavbar">
                            <ul class="nav navbar-nav">
                                <li class="dropdown">
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        Constituency Profile
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a href="/">Geographic Profile</a></li>
                                        <li><a href="/">Voters Profile </a></li>
                                        <li><a href="/">Demographic Profile </a></li>
                                        <li><a href="/">Housing Profile </a></li>
                                        <li><a href="/">Economic Profile </a></li>
                                        <li><a href="/">Agriculture Profile </a></li>
                                        <li><a href="/">Diaspora Profile </a></li>
                                    </ul>
                                </li>
                                <li class="dropdown">
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        Compaign Toolkit
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a href="/">Party Structure</a></li>
                                        <li><a href="/Home/Notable">Notables</a></li>
                                        <li><a href="/">Volunteers</a></li>
                                        <li><a href="/">Campaign Schedule</a></li>
                                        <li><a href="/">Event</a></li>
                                        <li><a href="/">Event Feedback</a></li>
                                        <li><a href="/">Campaign Management</a></li>
                                        <li><a href="/">Social Media Pages</a></li>
                                        <li><a href="/">Training</a></li>
                                        <li><a href="/">Budget Management</a></li>
                                        <li><a href="/">Election Survey</a></li>
                                        <li><a href="/">Broadcast SMS</a></li>
                                    </ul>
                                </li>
                                <li class="dropdown">
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        Election Day
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a href="/Home/Polling">Polling Stations</a></li>
                                        <li><a href="/">Polling Agents</a></li>
                                        <li><a href="/">Voter List</a></li>
                                        <li><a href="/">E-Parchi</a></li>
                                        <li><a href="/">Transport Management</a></li>
                                        <li><a href="/">Incident Reporting</a></li>
                                        <li><a href="/">Visit Reporting</a></li>
                                    </ul>
                                </li>

                                <li><a href="/Home/Result">Results</a></li>
                                <li><a href="/Training/Index">Training</a></li>
                                <li><a href="/Home/Forms">Forms</a></li>
                                <li class="dropdown">
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        Downloads
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a href="#"></a>ECP Code of Conduct</li>
                                        <li><a href="#"></a></li>
                                    </ul>
                                </li>


                            </ul>
                            <ul class="nav navbar-nav navbar-right">
                                <li><a href="#"><span class="glyphicon glyphicon-user"></span> Register</a></li>
                                <li><a href="#"><span class="glyphicon glyphicon-log-in"></span> Login</a></li>
                            </ul>
                        </div>
                    </div>
                    <img src="~/Content/img/bannerecp.jpg" style="height:360px; width:100%" />
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="margin-bottom:0px;">
                            <li class="breadcrumb-item"><a href="/Migration">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
                        </ol>
                    </nav>
                </nav>
                
            </div>
        </div>
        <main>
              @RenderBody()
        </main>

    </div>
    <div style="padding:5px; background-color:teal; color:white; text-align:center; position:static; font-size:14px; font-weight:bold; bottom:0; width:100%;">
        <p>Copyrights &copy; @DateTime.Now.Year</p>
        <p>V.I.C.T.O.R.Y </p>
    </div>
    <script src="~/script/js/jquery-3.7.1.min.js"></script>
    <script src="~/script/js/bootstrap.min.js"></script>
    <script src="~/script/js/highmaps.js"></script>
    <script src="~/script/js/data.js"></script>
    <script src="~/script/js/exporting.js"></script>
    <script src="~/script/js/offline-exporting.js"></script>
    <script>
        Highcharts.setOptions({
            credits: {
                enabled: true,
                useHTML: true,
                text: "<p style='color:black; font-size:10px;'>Credit: <a style='color:green; font-weight:bold; font-size:9px' href='http://www.pbs.gov.pk'>Pakistan Bureau of Statistics</a></p>",
                position: {
                    align: 'right',
                    x: -10,
                    verticalAlign: 'bottom',
                    y: -5
                },
                style: {
                    fontSize: '10px'
                }
            }
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>


