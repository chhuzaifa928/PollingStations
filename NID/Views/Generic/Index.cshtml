<script>
    $(document).ready(function () {

        // Prevent entire page from refreshing when form is submitted
        $(document).on("submit", "#frm", function (e) {
            e.preventDefault();
        });

        loadTable();
    });

    const skipColumns = ["id","created_date","modified_date","deleted_date","modified_by"]; // columns to skip

    function loadTable() {

        const table = $("#tableName").val();

        $.get(`/Generic/LoadTable?table=${table}`, function (data) {

            let html = "";
            const cfg = inputConfig[data.TableName] ?? {};

            // =============================== FORM ===============================
            html += `<form id='frm'>`;
            html += `<input type="hidden" id="_editKey" name="_editKey" />`;

            html += `<div class="container-fluid"><div class="row">`;
            html += `<div class="col-sm-12"><h3><b>${data.TableDescription || data.TableName}</b></h3></div>`;

            let count = 0;

            data.Columns.forEach(c => {
                if (!skipColumns.includes(c.toLowerCase())) {

                    const colCfg = cfg[c] || { type: "text" };

                    let inputHtml = "";

                    switch (colCfg.type) {

                        case "select":
                            inputHtml = `<select name="${c}" class="form-control">`;

                            colCfg.options?.forEach(o => {

                                let value, text;

                                // If option is an object ( { value, text } )
                                if (typeof o === "object") {
                                    value = o.value ?? o.text; // fallback to text if value not provided
                                    text = o.text ?? o.value; // fallback to value if text not provided
                                }
                                else {
                                    // If option is a string ("Yes", "No", etc.)
                                    value = o;
                                    text = o;
                                }

                                inputHtml += `<option value="${value}">${text}</option>`;
                            });

                            inputHtml += `</select>`;
                            break;


                        case "radio":
                            inputHtml = `<div>`;

                            colCfg.options?.forEach(o => {
                                const value = typeof o === "object" ? o.value : o;
                                const text = typeof o === "object" ? o.text : o;

                                inputHtml += `
                                    <label class="mr-2">
                                        <input type="radio" name="${c}" value="${value}"> ${text}
                                    </label>`;
                            });

                            inputHtml += `</div>`;
                            break;

                        case "number":
                            const phNum = colCfg.placeholder ? `placeholder="${colCfg.placeholder}"` : "";
                            inputHtml = `<input type="number" name="${c}" class="form-control" ${phNum} />`;
                            break;

                        case "date":
                            const phDate = colCfg.placeholder ? `placeholder="${colCfg.placeholder}"` : "";
                            inputHtml = `<input type="date" name="${c}" class="form-control" ${phDate} />`;
                            break;

                        default:
                            const max = colCfg.maxlength ? `maxlength="${colCfg.maxlength}"` : "";
                            const ph = colCfg.placeholder ? `placeholder="${colCfg.placeholder}"` : "";
                            inputHtml = `<input type="text" name="${c}" class="form-control" ${max} ${ph} />`;
                    }



                    html += `
                <div class="col-md-4">
                    <div class="form-group">
                        <label>${c}</label>
                        ${inputHtml}
                    </div>
                </div>`;

                    count++;

                    if (count % 3 === 0) {
                        html += `</div><div class="row">`;
                    }
                }
            });

            html += `</div>`; // close row
            html += `<div class='row'>
                    <div class="col-sm-12">
                        <button type="button" onclick="save()" class="btn btn-primary mt-2">Save</button>
                    </div>
                </div>
                </form><hr/>`;

            // =============================== TABLE ===============================
            html += `<table class='table table-bordered'>
                    <thead class='bg-primary'>
                        <tr>`;

            data.Columns.forEach(c => html += `<th>${c}</th>`);
            html += `<th>Actions</th></tr></thead><tbody>`;

            data.Rows.forEach(r => {
                html += `<tr>`;
                data.Columns.forEach(c => html += `<td>${r.Values[c] ?? ""}</td>`);

                const encoded = encodeURIComponent(JSON.stringify(r.Values));
                const id = r.Values[data.KeyColumn];

                html += `
                <td>
                    <button class="btn btn-warning btn-sm" onclick='editRow("${encoded}")'>Edit</button>
                    <button class="btn btn-danger btn-sm" onclick='deleteRow("${id}")'>Delete</button>
                </td>`;
                html += `</tr>`;
            });

            html += `</tbody></table>`;

            $("#crud-container").html(html);

            window._keyCol = data.KeyColumn;
        });
    }


    // =============================== EDIT ROW ===============================
    function editRow(encodedJson) {
        const row = JSON.parse(decodeURIComponent(encodedJson));

        for (let k in row) {
            const value = row[k];

            const sel = $(`select[name='${k}']`);
            if (sel.length) {
                sel.val(value);
                continue;
            }


            // Radio
            const radios = $(`input[type='radio'][name='${k}']`);
            if (radios.length) {
                radios.filter(`[value='${value}']`).prop("checked", true);
                continue;
            }

            // Normal input
            $(`[name='${k}']`).val(value);
        }

        if (row[_keyCol])
            $("#_editKey").val(row[_keyCol]);
    }


    // =============================== SAVE ===============================
    function save() {

        const table = $("#tableName").val();
        let row = { Values: {} };

        $("#frm").find("[name]").each(function () {

            const name = $(this).attr("name");
            if (name === "_editKey") return;

            if ($(this).attr("type") === "radio") {
                if ($(this).is(":checked")) {
                    row.Values[name] = $(this).val();
                }
            } else {
                row.Values[name] = $(this).val();
            }
        });

        row.Values[_keyCol] = $("#_editKey").val();

        $.ajax({
            url: "/Generic/Save",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ table: table, row: row, key: _keyCol }),
            success: function () {
                loadTable();
                $("#frm")[0].reset();
                $("#_editKey").val("");
            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        });
    }


    // =============================== DELETE ===============================
    function deleteRow(id) {

        if (!confirm("Delete?")) return;

        const table = $("#tableName").val();

        $.ajax({
            url: "/Generic/Delete",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ table: table, key: _keyCol, id: id }),
            success: function () {
                loadTable();
            },
            error: function (xhr) {
                alert("Delete failed: " + xhr.responseText);
            }
        });
    }
</script>

